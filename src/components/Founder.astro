---
import headshotSrc from '../assets/headshot-source.jpeg';

interface Props {
  showPortrait?: boolean;
}

const { showPortrait = true } = Astro.props;

const partners = [
  { label: 'Shopify Partner' },
  { label: 'Anthropic Claude Partner' },
  { label: 'Vercel Partner' },
];
---

<div class="flex flex-col md:flex-row gap-8 md:gap-12 items-start">
  {showPortrait && (
    <div class="shrink-0">
      <img
        src={headshotSrc.src}
        alt="Gabriel Rosales, Founder & Principal Engineer at Salt & Scale"
        width="256"
        height="320"
        class="rounded-2xl object-cover w-48 md:w-64 shadow-[0_4px_24px_rgba(55,62,69,0.12)]"
      />
    </div>
  )}
  <div class="flex flex-col gap-4">
    <div>
      <p class="text-h4 text-charcoal font-semibold">Gabriel Rosales</p>
      <p class="text-caption text-stone">Founder & Principal Engineer</p>
    </div>
    <p class="text-body text-charcoal/80 max-w-prose">
      Gabriel Rosales is the founder and principal engineer at Salt & Scale. Based in Houston, with 10+ years building production websites and commerce systems, and an open-source contributor to Shopify's Hydrogen storefront framework.
    </p>
    <div class="flex flex-wrap gap-2">
      {partners.map((p) => (
        <span class="inline-flex items-center rounded-full border border-sage/20 bg-sage/10 px-3 py-1 text-eyebrow text-sage">
          {p.label}
        </span>
      ))}
    </div>
    <div class="flex items-center gap-4 mt-1">
      <a
        href="https://www.linkedin.com/in/gabriel-rosales/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-caption text-stone hover:text-sage transition-colors duration-150 inline-flex items-center gap-1.5"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
        LinkedIn
      </a>
      <a
        href="https://github.com/notoriousgor"
        target="_blank"
        rel="noopener noreferrer"
        class="text-caption text-stone hover:text-sage transition-colors duration-150 inline-flex items-center gap-1.5"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        GitHub
      </a>
    </div>
  </div>
</div>
