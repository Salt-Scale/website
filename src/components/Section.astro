---
interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  id?: string;
  bg?: string;
}

const { eyebrow, title, lede, id, bg = 'bg-paper' } = Astro.props;
---

<section id={id} class={`${bg} py-14 md:py-20 px-4`}>
  <div class="mx-auto max-w-[1120px]">
    {eyebrow && (
      <div class="mb-4">
        <slot name="eyebrow">
          <span class="text-eyebrow text-sage">{eyebrow}</span>
        </slot>
      </div>
    )}
    {title && (
      <h2 class="text-display-2 text-charcoal mb-4">{title}</h2>
    )}
    {lede && (
      <p class="text-body-lg text-charcoal/70 max-w-2xl mb-10">{lede}</p>
    )}
    <slot />
  </div>
</section>
