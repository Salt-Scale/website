---
interface Props {
  question: string;
}

const { question } = Astro.props;
---

<details class="group border-b border-charcoal/10 py-4">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-h4 text-charcoal font-semibold">
    {question}
    <svg
      class="h-5 w-5 shrink-0 text-charcoal/50 transition-transform duration-150 group-open:rotate-90"
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m7 8 3 3 3-3" />
    </svg>
  </summary>
  <div class="text-body text-charcoal/70 pt-3 pb-1">
    <slot />
  </div>
</details>
