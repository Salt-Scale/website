---
interface Props {
  quote: string;
  name: string;
  role?: string;
  company: string;
  companyUrl?: string;
}

const { quote, name, role, company, companyUrl } = Astro.props;
---

<figure class="bg-white rounded-2xl shadow-[0_8px_32px_rgba(55,62,69,0.12)] border border-[rgba(55,62,69,0.08)] p-8 border-l-4 border-l-sage">
  <div class="font-serif text-6xl leading-none text-sage/20 select-none mb-2" aria-hidden="true">&ldquo;</div>
  <blockquote class="text-body-lg text-charcoal mb-6">
    <p>{quote}</p>
  </blockquote>
  <figcaption class="text-caption text-stone">
    <cite class="not-italic">
      <span class="font-semibold text-charcoal">{name}</span>
      {role && <span class="before:content-[',_']">{role}</span>}
      {companyUrl ? (
        <a href={companyUrl} class="text-saffron-deep hover:underline before:content-['_—_']" target="_blank" rel="noopener noreferrer">{company}</a>
      ) : (
        <span class="before:content-['_—_']">{company}</span>
      )}
    </cite>
  </figcaption>
</figure>
