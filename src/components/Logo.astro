---
export interface Props {
  height?: number;
}

const { height = 28 } = Astro.props as Props;
---

<svg
  viewBox="0 0 700 120"
  height={height}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-labelledby="logoTitle"
  role="img"
>
  <title id="logoTitle">Salt &amp; Scale</title>
  <g fill="#373E45">
    <text x="170" y="78" text-anchor="end" font-family="'Playfair Display', serif" font-size="52" letter-spacing="2">SALT</text>
    <text x="530" y="78" text-anchor="start" font-family="'Playfair Display', serif" font-size="52" letter-spacing="2">SCALE</text>
  </g>
  <g transform="translate(335,34)">
    <path d="M30 0 L60 30 L30 60 L0 30 Z" fill="#373E45"></path>
    <path d="M18 36 L30 29 L42 36" fill="none" stroke="#F4E3C3" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
  </g>
</svg>
