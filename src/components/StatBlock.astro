---
interface Props {
  stat: string;
  label: string;
  source?: string;
}

const { stat, label, source } = Astro.props;
---

<div class="flex flex-col gap-1">
  <p class="font-serif font-semibold text-saffron" style="font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1;">
    {stat}{source && <sup class="text-base text-stone align-super ml-0.5">*</sup>}
  </p>
  <p class="text-caption text-stone uppercase tracking-wide font-semibold">{label}</p>
  {source && (
    <p class="text-caption text-stone/70 mt-1">* {source}</p>
  )}
</div>
