---
interface Props {
  variant?: 'default' | 'flat' | 'dark' | 'cream' | 'outline';
  class?: string;
}

const { variant = 'default', class: extraClass = '' } = Astro.props;

const variantClasses: Record<string, string> = {
  default: 'bg-white border border-charcoal/10',
  flat: 'bg-paper',
  dark: 'bg-charcoal text-white',
  cream: 'bg-cream border border-charcoal/8',
  outline: 'border border-charcoal/20 bg-transparent',
};
---

<div class={`${variantClasses[variant]} p-8 md:p-10 ${extraClass}`}>
  <slot />
</div>
