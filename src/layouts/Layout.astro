---
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';

export interface Breadcrumb {
  name: string;
  url: string;
}

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  breadcrumbs?: Breadcrumb[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Salt & Scale · Growth, grounded in Truth.',
  description = 'Ecommerce engineering for Shopify and Adobe Commerce. Headless builds, custom apps, integrations, and performance, delivered with clear tradeoffs and measurable outcomes.',
  ogImage = '/og-image.jpg',
  canonicalPath,
  breadcrumbs,
  schema,
} = Astro.props;

const canonicalHref = Astro.site
  ? new URL(canonicalPath ?? Astro.url.pathname, Astro.site).toString()
  : undefined;

const ogTitle = title;

const siteUrl = Astro.site ? new URL('/', Astro.site).toString() : 'https://saltandscale.consulting/';
const absolute = (path: string) =>
  Astro.site ? new URL(path, Astro.site).toString() : `https://saltandscale.consulting${path}`;

const currentPath = Astro.url.pathname;

// JSON-LD `@id` URIs are stable entity identifiers, not URLs that get fetched —
// they intentionally stay pinned to the canonical domain even on preview deploys
// so structured-data graph identity is consistent.
const defaultGraph = [
  {
    '@type': 'Organization',
    '@id': 'https://saltandscale.consulting/#org',
    name: 'Salt & Scale',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: absolute('/icons/icon-c-monogram.svg'),
    },
    founder: { '@id': 'https://saltandscale.consulting/#founder' },
    areaServed: 'United States',
    knowsAbout: [
      'Website design',
      'Web development',
      'Shopify development',
      'Adobe Commerce',
      'Headless commerce',
      'AI-accelerated development',
      'Web accessibility',
      'Core Web Vitals',
    ],
    sameAs: ['https://github.com/Salt-Scale'],
  },
  {
    '@type': 'Person',
    '@id': 'https://saltandscale.consulting/#founder',
    name: 'Gabriel Rosales',
    jobTitle: 'Founder & Principal Engineer',
    worksFor: { '@id': 'https://saltandscale.consulting/#org' },
    image: absolute('/headshot-square.jpg'),
    sameAs: [
      'https://www.linkedin.com/in/gabriel-rosales/',
      'https://github.com/notoriousgor',
      'https://github.com/Salt-Scale',
      'https://gabriel-rosales.com',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': 'https://saltandscale.consulting/#website',
    url: siteUrl,
    name: 'Salt & Scale',
    publisher: { '@id': 'https://saltandscale.consulting/#org' },
  },
];

const customGraph = schema ? [schema].flat() : [];

const breadcrumbGraph = breadcrumbs && breadcrumbs.length
  ? [
      {
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: absolute(b.url),
        })),
      },
    ]
  : [];

const graph = {
  '@context': 'https://schema.org',
  '@graph': [...defaultGraph, ...customGraph, ...breadcrumbGraph],
};

// Defense in depth — escape the only character sequence that can break out of
// a <script> tag from inside a JSON literal. Even with `set:html` the JSON.stringify
// output is safe except for `</`, which we encode as \u003c per spec.
const graphJson = JSON.stringify(graph).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    {canonicalHref && <meta property="og:url" content={canonicalHref} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:site_name" content="Salt & Scale" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="dns-prefetch" href="https://vitals.vercel-insights.com" />
    <link rel="preconnect" href="https://vitals.vercel-insights.com" crossorigin />
    <Analytics />
    <script type="application/ld+json" set:html={graphJson}></script>
  </head>
  <body class="bg-paper font-sans text-charcoal antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] inline-flex items-center bg-saffron px-4 py-2 text-ink font-medium">Skip to content</a>

    {/* Editorial header — sticky paper with hairline saffron divider on scroll */}
    <header class="sticky top-0 z-50 bg-paper/85 backdrop-blur supports-[backdrop-filter]:bg-paper/75 border-b border-charcoal/8">
      <div class="relative mx-auto flex max-w-[1280px] items-center justify-between px-6 md:px-10 h-[68px]">

        {/* Logo */}
        <a href="/" class="inline-flex items-center gap-2 leading-none -ml-1">
          <img
            src="/icons/icon-d-integrated.svg"
            alt="Salt & Scale"
            height="44"
            width="156"
            class="h-10 md:h-11 w-auto align-middle"
          />
        </a>

        {/* Desktop nav — uppercase tracked, editorial */}
        <nav aria-label="Primary" class="hidden md:flex items-center gap-8">
          {[
            { href: '/services/', label: 'Services' },
            { href: '/work/', label: 'Work' },
            { href: '/about/', label: 'About' },
            { href: '/insights/', label: 'Insights' },
          ].map((item) => {
            // item.href always ends with '/', so startsWith correctly matches
            // sub-pages (`/services/foo/`) without false-matching siblings (`/services-archive/`).
            const isActive = currentPath === item.href || currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class={`relative text-[0.8125rem] uppercase tracking-[0.15em] font-medium transition-colors duration-150 py-1.5 ${isActive ? 'text-saffron-deep' : 'text-charcoal/80 hover:text-charcoal'}`}
              >
                {item.label}
                {isActive && <span class="absolute left-0 right-0 -bottom-0.5 h-px bg-saffron" aria-hidden="true"></span>}
              </a>
            );
          })}
          <a
            href="/contact/"
            class="group inline-flex items-center gap-2 bg-charcoal text-paper px-5 py-2.5 text-[0.8125rem] uppercase tracking-[0.15em] font-medium hover:bg-saffron hover:text-ink transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-saffron focus-visible:ring-offset-2"
          >
            Schedule a call
            <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-0.5">→</span>
          </a>
        </nav>

        {/* Mobile hamburger */}
        <button id="menu-toggle" class="md:hidden inline-flex h-10 w-10 items-center justify-center text-charcoal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-saffron focus-visible:ring-offset-2" aria-controls="mobile-menu" aria-expanded="false">
          <span class="sr-only">Open menu</span>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7h16M4 12h16M4 17h16"/>
          </svg>
        </button>
      </div>
    </header>

    {/* Mobile menu — full-screen overlay with editorial styling */}
    <div id="mobile-menu" class="fixed inset-0 z-[60] hidden" role="dialog" aria-modal="true">
      <div id="mobile-overlay" class="absolute inset-0 bg-charcoal/40" aria-hidden="true"></div>
      <div class="relative ml-auto h-full w-full max-w-sm bg-paper shadow-2xl p-8 border-l border-charcoal/10 flex flex-col">
        <button id="menu-close" class="absolute top-5 right-5 inline-flex h-10 w-10 items-center justify-center text-charcoal hover:text-saffron-deep transition-colors" aria-label="Close menu">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>

        <div class="flex items-center gap-3 mb-12 mt-1">
          <span class="block h-px w-8 bg-saffron" aria-hidden="true"></span>
          <p class="text-eyebrow text-saffron-deep">Menu</p>
        </div>

        <nav class="flex flex-col gap-1 flex-1" aria-label="Mobile">
          {[
            { href: '/services/', label: 'Services' },
            { href: '/work/', label: 'Work' },
            { href: '/about/', label: 'About' },
            { href: '/insights/', label: 'Insights' },
          ].map((item) => {
            // item.href always ends with '/', so startsWith correctly matches
            // sub-pages (`/services/foo/`) without false-matching siblings (`/services-archive/`).
            const isActive = currentPath === item.href || currentPath.startsWith(item.href);
            return (
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class={`font-serif text-[1.625rem] tracking-[-0.012em] py-2 transition-colors ${isActive ? 'text-saffron-deep' : 'text-charcoal hover:text-saffron-deep'}`}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <a href="/contact/" class="group inline-flex items-center justify-between gap-3 bg-charcoal text-paper px-6 py-4 text-[0.8125rem] uppercase tracking-[0.15em] font-medium hover:bg-saffron hover:text-ink transition-colors mt-6">
          Schedule a call
          <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-0.5">→</span>
        </a>
      </div>
    </div>
    <main id="main">
      <slot />
    </main>
    {/* Editorial footer — charcoal, generous, layered */}
    <footer class="bg-charcoal text-paper/85 relative overflow-hidden grain grain-dark">
      <div class="relative max-w-[1280px] mx-auto px-6 md:px-10 pt-24 md:pt-32 pb-12">

        {/* Top: Big editorial CTA-ish block */}
        <div class="grid md:grid-cols-[1.4fr_1fr] gap-12 md:gap-20 pb-16 md:pb-24 border-b border-paper/15">
          <div>
            <div class="flex items-center gap-4 mb-8">
              <span class="block h-px w-12 bg-saffron" aria-hidden="true"></span>
              <p class="text-eyebrow text-saffron">Salt &amp; Scale · Houston, TX</p>
            </div>
            <p class="font-serif font-medium text-[clamp(1.875rem,4vw,3rem)] leading-[1.1] tracking-[-0.018em] text-paper max-w-[18ch] mb-8">
              Growth, <span class="italic text-saffron">grounded</span> in Truth.
            </p>
            <p class="text-[1.0625rem] leading-[1.65] text-paper/65 max-w-[50ch] mb-8">
              Production-grade websites for service businesses, built by one senior engineer with ten years in commerce.
            </p>
            <div class="flex items-center gap-5">
              <a
                href="https://www.linkedin.com/in/gabriel-rosales/"
                rel="noopener noreferrer"
                target="_blank"
                aria-label="Gabriel Rosales on LinkedIn"
                class="text-paper/55 hover:text-saffron transition-colors"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
              <a
                href="https://github.com/notoriousgor"
                rel="noopener noreferrer"
                target="_blank"
                aria-label="Gabriel Rosales on GitHub"
                class="text-paper/55 hover:text-saffron transition-colors"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
              </a>
            </div>
          </div>

          <div class="flex md:justify-end">
            <a
              href="/contact/"
              class="group inline-flex items-center gap-3 bg-saffron text-ink px-8 py-4 text-[0.95rem] tracking-wide font-medium hover:bg-cream transition-colors self-start"
            >
              Schedule a call
              <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span>
            </a>
          </div>
        </div>

        {/* 4-column sitemap */}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-10 md:gap-12 pt-16 md:pt-20">

          <div>
            <p class="text-eyebrow text-saffron mb-6">Services</p>
            <ul class="flex flex-col gap-3">
              <li><a href="/services/business-websites/" class="text-[0.9375rem] text-paper/70 hover:text-saffron transition-colors">Websites for service businesses</a></li>
              <li><a href="/services/" class="text-[0.9375rem] text-paper/55 hover:text-saffron transition-colors">Ecommerce engineering &rarr;</a></li>
            </ul>
          </div>

          <div>
            <p class="text-eyebrow text-saffron mb-6">Work</p>
            <ul class="flex flex-col gap-3">
              <li><a href="/work/mahi-plumbing/" class="text-[0.9375rem] text-paper/70 hover:text-saffron transition-colors">Mahi Plumbing</a></li>
              <li><a href="/work/aim-global-transport/" class="text-[0.9375rem] text-paper/70 hover:text-saffron transition-colors">AIM Global Transport</a></li>
              <li><a href="/work/premier-door-innovations/" class="text-[0.9375rem] text-paper/70 hover:text-saffron transition-colors">Premier Door</a></li>
              <li><a href="/work/elevated-water-solutions/" class="text-[0.9375rem] text-paper/70 hover:text-saffron transition-colors">Elevated Water</a></li>
              <li class="mt-1"><a href="/work/" class="text-[0.9375rem] text-saffron hover:text-cream transition-colors inline-flex items-baseline gap-1">All work <span aria-hidden="true">→</span></a></li>
            </ul>
          </div>

          <div>
            <p class="text-eyebrow text-saffron mb-6">Company</p>
            <ul class="flex flex-col gap-3">
              <li><a href="/about/" class="text-[0.9375rem] text-paper/70 hover:text-saffron transition-colors">About</a></li>
              <li><a href="/insights/" class="text-[0.9375rem] text-paper/70 hover:text-saffron transition-colors">Insights</a></li>
              <li><a href="/contact/" class="text-[0.9375rem] text-paper/70 hover:text-saffron transition-colors">Contact</a></li>
            </ul>
          </div>

          <div>
            <p class="text-eyebrow text-saffron mb-6">Legal</p>
            <ul class="flex flex-col gap-3">
              <li><a href="/legal/privacy/" class="text-[0.9375rem] text-paper/70 hover:text-saffron transition-colors">Privacy</a></li>
              <li><a href="/legal/terms/" class="text-[0.9375rem] text-paper/70 hover:text-saffron transition-colors">Terms</a></li>
              <li><a href="/legal/accessibility/" class="text-[0.9375rem] text-paper/70 hover:text-saffron transition-colors">Accessibility</a></li>
            </ul>
          </div>
        </div>

        {/* Bottom: copyright, scripture, partners */}
        <div class="mt-20 pt-8 border-t border-paper/10 grid gap-4 md:grid-cols-[1fr_auto_1fr] md:items-center">
          <p class="text-[0.8125rem] text-paper/45 tracking-wide">© {new Date().getFullYear()} Salt &amp; Scale · Houston, TX</p>
          <p id="sotd-verse" class="text-[0.8125rem] leading-snug text-paper/45 italic font-serif text-center max-w-[60ch]">Loading daily scripture…</p>
          <p class="text-[0.8125rem] text-paper/45 tracking-wide md:text-right">
            Shopify · Claude · Vercel Partner
          </p>
        </div>
      </div>
    </footer>
    <script>
      // @ts-nocheck

      // simple in-view animation
      const animateObserver = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('opacity-100','translate-y-0');
            animateObserver.unobserve(e.target);
          }
        })
      }, { threshold: 0.15 });

      document.querySelectorAll('[data-animate]').forEach(el => {
        el.classList.add('opacity-0','translate-y-4','transition','duration-700');
        animateObserver.observe(el);
      });

      // Mobile menu
      const menu = document.getElementById('mobile-menu');
      const openBtn = document.getElementById('menu-toggle');
      const closeBtn = document.getElementById('menu-close');
      const overlay = document.getElementById('mobile-overlay');

      const mainEl = document.getElementById('main');
      const headerEl = document.querySelector('header');
      const footerEl = document.querySelector('footer');
      const skipLinkEl = document.querySelector('a[href="#main"]');

      const openMenu = () => {
        menu?.classList.remove('hidden');
        openBtn?.setAttribute('aria-expanded','true');
        closeBtn?.focus();
        document.body.style.overflow = 'hidden';
        // WCAG 2.2 §9.2 — inert every focusable sibling of the dialog so
        // keyboard + AT can't escape behind it (skip-link, header, main, footer).
        if (skipLinkEl) skipLinkEl.inert = true;
        if (mainEl) mainEl.inert = true;
        if (headerEl) headerEl.inert = true;
        if (footerEl) footerEl.inert = true;
      };

      const closeMenu = () => {
        menu?.classList.add('hidden');
        openBtn?.setAttribute('aria-expanded','false');
        openBtn?.focus();
        document.body.style.overflow = '';
        if (skipLinkEl) skipLinkEl.inert = false;
        if (mainEl) mainEl.inert = false;
        if (headerEl) headerEl.inert = false;
        if (footerEl) footerEl.inert = false;
      };

      openBtn?.addEventListener('click', openMenu);
      closeBtn?.addEventListener('click', closeMenu);
      overlay?.addEventListener('click', closeMenu);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });

      // Scripture of the Day — idle, low-priority, no-referrer.
      // Disclosed in /legal/privacy/. Cached at the HTTP layer (the API
      // returns a daily payload) so we drop the `no-store` that was forcing
      // a full round-trip on every page view.
      const sotdEl = document.getElementById('sotd-verse');
      const loadSotd = () => {
        if (!sotdEl) return;
        fetch('https://beta.ourmanna.com/api/v1/get/?format=json&order=daily', {
          referrerPolicy: 'no-referrer',
        })
          .then(r => r.json())
          .then(d => {
            const details = d?.verse?.details || d?.verses?.[0] || d;
            const text = details?.text || details?.verse || '';
            const ref = details?.reference || details?.display_ref || '';
            if (text) {
              sotdEl.textContent = ref ? `"${text}" — ${ref}` : `"${text}"`;
            } else {
              sotdEl.remove();
            }
          })
          .catch(() => sotdEl.remove());
      };

      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadSotd, { timeout: 2000 });
      } else {
        setTimeout(loadSotd, 1200);
      }
    </script>
  </body>
</html>
