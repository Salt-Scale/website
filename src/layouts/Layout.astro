---
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';

export interface Breadcrumb {
  name: string;
  url: string;
}

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  breadcrumbs?: Breadcrumb[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Salt & Scale – Growth, grounded in Truth.',
  description = 'Ecommerce engineering for Shopify and Adobe Commerce. Headless builds, custom apps, integrations, and performance—delivered with clear tradeoffs and measurable outcomes.',
  ogImage = '/og-image.jpg',
  canonicalPath,
  breadcrumbs,
  schema,
} = Astro.props;

const canonicalHref = Astro.site
  ? new URL(canonicalPath ?? Astro.url.pathname, Astro.site).toString()
  : undefined;

const ogTitle = title.replace(/–/g, '—');

const defaultGraph = [
  {
    '@type': 'Organization',
    name: 'Salt & Scale',
    url: Astro.site ? new URL('/', Astro.site).toString() : undefined,
    logo: '/logo-mark.svg',
    sameAs: [] as string[],
  },
  {
    '@type': 'WebSite',
    name: 'Salt & Scale',
    url: Astro.site ? new URL('/', Astro.site).toString() : undefined,
    potentialAction: {
      '@type': 'SearchAction',
      target: Astro.site
        ? new URL('/?q={search_term_string}', Astro.site).toString()
        : undefined,
      'query-input': 'required name=search_term_string',
    },
  },
];

const customGraph = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];

const breadcrumbGraph = breadcrumbs && breadcrumbs.length
  ? [
      {
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: Astro.site ? new URL(b.url, Astro.site).toString() : b.url,
        })),
      },
    ]
  : [];

const graph = {
  '@context': 'https://schema.org',
  '@graph': [...defaultGraph, ...customGraph, ...breadcrumbGraph],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    {canonicalHref && <meta property="og:url" content={canonicalHref} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:site_name" content="Salt & Scale" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="dns-prefetch" href="https://vitals.vercel-insights.com" />
    <link rel="preconnect" href="https://vitals.vercel-insights.com" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/playfair-var.woff2" as="font" type="font/woff2" crossorigin>
    <Analytics />
    <script type="application/ld+json" set:html={JSON.stringify(graph)}></script>
  </head>
  <body class="bg-white font-sans text-charcoal antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] inline-flex items-center rounded-md bg-sage px-3 py-2 text-white">Skip to content</a>
    <header
      class="sticky top-0 z-50 border-b border-[rgba(55,62,69,0.08)] bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70"
    >
      <div
        class="relative mx-auto flex max-w-[1120px] items-center justify-center md:justify-between pl-6 pr-5 sm:px-6 md:px-4 py-3"
      >
        <a href="/" class="inline-flex items-center gap-2 leading-none">
          <img
            src="/icons/icon-d-integrated.svg"
            alt="Salt & Scale"
            height="42"
            width="150"
            class="h-[42px] md:h-[48px] w-auto align-middle"
          />
        </a>
        <nav aria-label="Primary" class="hidden md:flex items-center gap-5">
          <a
            href="#services"
            class="flex items-center font-medium text-charcoal hover:underline"
            data-nav="services"
            >Services</a
          >
          <a
            href="#approach"
            class="flex items-center font-medium text-charcoal hover:underline"
            data-nav="approach"
            >Approach</a
          >
          <a
            href="#experience"
            class="flex items-center font-medium text-charcoal hover:underline"
            data-nav="experience"
            >Experience</a
          >
          <a
            href="#work"
            class="flex items-center font-medium text-charcoal hover:underline"
            data-nav="work"
            >Work</a
          >
          <a
            href="#faq"
            class="flex items-center font-medium text-charcoal hover:underline"
            data-nav="faq"
            >FAQ</a
          >
          <a
            href="#contact"
            class="inline-flex items-center justify-center rounded-lg bg-charcoal px-4 py-2 font-semibold text-white shadow-sm transition hover:opacity-90 focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:outline-none active:translate-y-px"
            >Start a project</a
          >
        </nav>
        <button id="menu-toggle" class="md:hidden inline-flex items-center justify-center rounded-lg border border-[rgba(55,62,69,0.12)] px-3 py-2 text-charcoal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 absolute right-5 top-1/2 -translate-y-1/2 md:static md:translate-y-0" aria-controls="mobile-menu" aria-expanded="false">
          <span class="sr-only">Open menu</span>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </header>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="fixed inset-0 z-[60] hidden" role="dialog" aria-modal="true">
      <div id="mobile-overlay" class="absolute inset-0 bg-black/40" aria-hidden="true"></div>
      <div class="relative ml-auto h-full w-[88%] max-w-xs bg-white shadow-2xl p-5 border-l border-[rgba(55,62,69,0.08)]">
        <button id="menu-close" class="absolute top-4 right-4 inline-flex h-8 w-8 items-center justify-center rounded-full border border-[rgba(55,62,69,0.12)] hover:bg-[#f7f8f9]" aria-label="Close menu">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
        <nav class="flex flex-col gap-2 pt-6" aria-label="Mobile">
          <a href="#services" class="px-3 py-2 rounded-lg hover:bg-[#f7f8f9]">Services</a>
          <a href="#approach" class="px-3 py-2 rounded-lg hover:bg-[#f7f8f9]">Approach</a>
          <a href="#experience" class="px-3 py-2 rounded-lg hover:bg-[#f7f8f9]">Experience</a>
          <a href="#work" class="px-3 py-2 rounded-lg hover:bg-[#f7f8f9]">Work</a>
          <a href="#faq" class="px-3 py-2 rounded-lg hover:bg-[#f7f8f9]">FAQ</a>
          <a href="#contact" class="mt-2 inline-flex items-center justify-center rounded-lg bg-charcoal px-4 py-2 font-semibold text-white">Start a project</a>
        </nav>
      </div>
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class="mx-auto mt-8 max-w-[1120px] px-4 py-8">
      <div class="h-px w-full bg-sage/30"></div>
      <div class="mt-4 grid gap-2 sm:grid-cols-3 sm:items-center">
        <p class="m-0 text-center sm:text-left">© {new Date().getFullYear()} Salt & Scale</p>
        <p id="sotd-verse" class="m-0 text-[13px] leading-snug text-charcoal/70 text-center px-2">Loading daily scripture…</p>
        <p class="m-0 text-sage text-center sm:text-right">
          Growth, grounded in Truth.
        </p>
      </div>
    </footer>
    <script>
      // @ts-nocheck
      const sectionIds = ["services","approach","experience","work","faq","contact"];
      const links = new Map(sectionIds.map(id => [id, document.querySelector(`a[data-nav="${id}"]`)]));

      /**
       * @param {string} activeId
       */
      function setActive(activeId) {
        links.forEach((el, id) => {
          if (!el) return;
          if (id === activeId) {
            el.classList.add("text-sage","underline");
          } else {
            el.classList.remove("text-sage","underline");
          }
        });
      }

      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter(e => e.isIntersecting)
          .sort((a,b) => b.intersectionRatio - a.intersectionRatio);
        if (visible[0]) setActive(visible[0].target.id);
      }, { rootMargin: "-20% 0px -60% 0px", threshold: [0.1, 0.25, 0.5, 0.75, 1] });

      sectionIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      });

      // simple in-view animation
      const animateObserver = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('opacity-100','translate-y-0');
            animateObserver.unobserve(e.target);
          }
        })
      }, { threshold: 0.15 });

      document.querySelectorAll('[data-animate]').forEach(el => {
        el.classList.add('opacity-0','translate-y-4','transition','duration-700');
        animateObserver.observe(el);
      });

      // Mobile menu
      const menu = document.getElementById('mobile-menu');
      const openBtn = document.getElementById('menu-toggle');
      const closeBtn = document.getElementById('menu-close');
      const overlay = document.getElementById('mobile-overlay');

      const openMenu = () => {
        menu?.classList.remove('hidden');
        openBtn?.setAttribute('aria-expanded','true');
        closeBtn?.focus();
        document.body.style.overflow = 'hidden';
      };

      const closeMenu = () => {
        menu?.classList.add('hidden');
        openBtn?.setAttribute('aria-expanded','false');
        openBtn?.focus();
        document.body.style.overflow = '';
      };

      openBtn?.addEventListener('click', openMenu);
      closeBtn?.addEventListener('click', closeMenu);
      overlay?.addEventListener('click', closeMenu);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });

      // Scripture of the Day (idle to avoid impacting metrics)
      const sotdEl = document.getElementById('sotd-verse');
      const loadSotd = () => {
        if (!sotdEl) return;
        fetch('https://beta.ourmanna.com/api/v1/get/?format=json&order=daily', { cache: 'no-store' })
          .then(r => r.json())
          .then(d => {
            const details = d?.verse?.details || d?.verses?.[0] || d;
            const text = details?.text || details?.verse || '';
            const ref = details?.reference || details?.display_ref || '';
            if (text) {
              sotdEl.textContent = ref ? `"${text}" — ${ref}` : `"${text}"`;
            } else {
              sotdEl.remove();
            }
          })
          .catch(() => sotdEl.remove());
      };

      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadSotd, { timeout: 2000 });
      } else {
        setTimeout(loadSotd, 1200);
      }
    </script>
  </body>
</html>
