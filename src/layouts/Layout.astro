---
import "../styles/global.css";
---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
		<title>Salt &amp; Scale – Growth, grounded in truth.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-[--color-bg] font-sans text-[--color-primary-navy] antialiased"
  >
    <header
      class="mx-auto flex max-w-[1120px] items-center justify-between px-4 py-4"
    >
			<a href="/" class="inline-flex items-center gap-2 leading-none">
				<img src="/icons/icon-d-integrated.svg" alt="Salt &amp; Scale" height="28" class="h-[28px] w-auto align-middle" />
			</a>
      <nav aria-label="Primary" class="flex gap-4">
        <a href="#services" class="hover:underline">Services</a>
        <a href="#approach" class="hover:underline">Approach</a>
        <a href="#work" class="hover:underline">Work</a>
        <a
          href="#contact"
          class="inline-flex items-center justify-center rounded-lg bg-[--color-accent-brown] px-4 py-2 font-semibold text-white transition hover:opacity-90 active:translate-y-px"
          >Start a project</a
        >
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer
      class="mx-auto mt-8 flex max-w-[1120px] items-center justify-between border-t border-[rgba(55,62,69,0.15)] px-4 py-8"
    >
      <p class="m-0">© {new Date().getFullYear()} Salt & Scale</p>
      <p class="m-0 text-[--color-supporting-green]">
        Growth, grounded in truth.
      </p>
    </footer>
  </body>
</html>
