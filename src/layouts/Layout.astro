---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
		<title>Salt &amp; Scale – Growth, grounded in truth.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-[--color-bg] font-sans text-[--color-primary-navy] antialiased"
  >
    <header class="sticky top-0 z-50 border-b border-[rgba(55,62,69,0.08)] bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70">
      <div class="mx-auto flex max-w-[1120px] items-center justify-between px-4 py-3">
        <a href="/" class="inline-flex items-center gap-2 leading-none">
          <img src="/icons/icon-d-integrated.svg" alt="Salt &amp; Scale" height="28" class="h-[28px] w-auto align-middle" />
        </a>
        <nav aria-label="Primary" class="flex gap-5">
          <a href="#services" class="font-medium text-[--color-primary-navy] hover:underline">Services</a>
          <a href="#approach" class="font-medium text-[--color-primary-navy] hover:underline">Approach</a>
          <a href="#work" class="font-medium text-[--color-primary-navy] hover:underline">Work</a>
          <a
            href="#contact"
            class="inline-flex items-center justify-center rounded-lg bg-[--color-accent-brown] px-4 py-2 font-semibold text-white shadow-sm transition hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[--color-supporting-green] focus-visible:ring-offset-2 active:translate-y-px"
            >Start a project</a
          >
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mx-auto mt-8 max-w-[1120px] px-4 py-8">
      <div class="h-px w-full bg-[--color-supporting-green]/30"></div>
      <div class="mt-4 flex items-center justify-between">
        <p class="m-0">© {new Date().getFullYear()} Salt & Scale</p>
        <p class="m-0 text-[--color-supporting-green]">Growth, grounded in truth.</p>
      </div>
    </footer>
  </body>
</html>
