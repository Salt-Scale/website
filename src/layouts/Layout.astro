---
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';

export interface Breadcrumb {
  name: string;
  url: string;
}

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  breadcrumbs?: Breadcrumb[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Salt & Scale – Growth, grounded in Truth.',
  description = 'Ecommerce engineering for Shopify and Adobe Commerce. Headless builds, custom apps, integrations, and performance—delivered with clear tradeoffs and measurable outcomes.',
  ogImage = '/og-image.jpg',
  canonicalPath,
  breadcrumbs,
  schema,
} = Astro.props;

const canonicalHref = Astro.site
  ? new URL(canonicalPath ?? Astro.url.pathname, Astro.site).toString()
  : undefined;

const ogTitle = title.replace(/–/g, '—');

const siteUrl = Astro.site ? new URL('/', Astro.site).toString() : 'https://saltandscale.consulting/';

const defaultGraph = [
  {
    '@type': 'Organization',
    '@id': 'https://saltandscale.consulting/#org',
    name: 'Salt & Scale',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: 'https://saltandscale.consulting/icons/icon-c-monogram.svg',
    },
    founder: { '@id': 'https://saltandscale.consulting/#founder' },
    areaServed: 'United States',
    knowsAbout: [
      'Website design',
      'Web development',
      'Shopify development',
      'Adobe Commerce',
      'Headless commerce',
      'AI-accelerated development',
      'Web accessibility',
      'Core Web Vitals',
    ],
    sameAs: ['https://github.com/Salt-Scale'],
  },
  {
    '@type': 'Person',
    '@id': 'https://saltandscale.consulting/#founder',
    name: 'Gabriel Rosales',
    jobTitle: 'Founder & Principal Engineer',
    worksFor: { '@id': 'https://saltandscale.consulting/#org' },
    image: 'https://saltandscale.consulting/headshot-square.jpg',
    sameAs: [
      'https://www.linkedin.com/in/gabriel-rosales/',
      'https://github.com/notoriousgor',
      'https://github.com/Salt-Scale',
      'https://gabriel-rosales.com',
    ],
  },
  {
    '@type': 'WebSite',
    '@id': 'https://saltandscale.consulting/#website',
    url: siteUrl,
    name: 'Salt & Scale',
    publisher: { '@id': 'https://saltandscale.consulting/#org' },
  },
];

const customGraph = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];

const breadcrumbGraph = breadcrumbs && breadcrumbs.length
  ? [
      {
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: Astro.site ? new URL(b.url, Astro.site).toString() : b.url,
        })),
      },
    ]
  : [];

const graph = {
  '@context': 'https://schema.org',
  '@graph': [...defaultGraph, ...customGraph, ...breadcrumbGraph],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    {canonicalHref && <meta property="og:url" content={canonicalHref} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:site_name" content="Salt & Scale" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="dns-prefetch" href="https://vitals.vercel-insights.com" />
    <link rel="preconnect" href="https://vitals.vercel-insights.com" crossorigin />
    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/playfair-var.woff2" as="font" type="font/woff2" crossorigin>
    <Analytics />
    <script type="application/ld+json" set:html={JSON.stringify(graph)}></script>
  </head>
  <body class="bg-white font-sans text-charcoal antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] inline-flex items-center rounded-md bg-sage px-3 py-2 text-white">Skip to content</a>
    <header
      class="sticky top-0 z-50 border-b border-[rgba(55,62,69,0.08)] bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/70"
    >
      <div
        class="relative mx-auto flex max-w-[1120px] items-center justify-center md:justify-between pl-6 pr-5 sm:px-6 md:px-4 py-3"
      >
        <a href="/" class="inline-flex items-center gap-2 leading-none">
          <img
            src="/icons/icon-d-integrated.svg"
            alt="Salt & Scale"
            height="42"
            width="150"
            class="h-[42px] md:h-[48px] w-auto align-middle"
          />
        </a>
        <nav aria-label="Primary" class="hidden md:flex items-center gap-5">
          <a
            href="/services/"
            class="flex items-center font-medium text-charcoal hover:underline"
            >Services</a
          >
          <a
            href="/work/"
            class="flex items-center font-medium text-charcoal hover:underline"
            >Work</a
          >
          <a
            href="/about/"
            class="flex items-center font-medium text-charcoal hover:underline"
            >About</a
          >
          <a
            href="/insights/"
            class="flex items-center font-medium text-charcoal hover:underline"
            >Insights</a
          >
          <a
            href="/contact/"
            class="inline-flex items-center justify-center rounded-lg bg-saffron px-4 py-2 font-semibold text-ink shadow-sm transition hover:bg-saffron/90 focus-visible:ring-2 focus-visible:ring-saffron focus-visible:ring-offset-2 focus-visible:outline-none active:translate-y-px"
            >Contact</a
          >
        </nav>
        <button id="menu-toggle" class="md:hidden inline-flex items-center justify-center rounded-lg border border-[rgba(55,62,69,0.12)] px-3 py-2 text-charcoal focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 absolute right-5 top-1/2 -translate-y-1/2 md:static md:translate-y-0" aria-controls="mobile-menu" aria-expanded="false">
          <span class="sr-only">Open menu</span>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </header>
    <!-- Mobile menu -->
    <div id="mobile-menu" class="fixed inset-0 z-[60] hidden" role="dialog" aria-modal="true">
      <div id="mobile-overlay" class="absolute inset-0 bg-black/40" aria-hidden="true"></div>
      <div class="relative ml-auto h-full w-[88%] max-w-xs bg-white shadow-2xl p-5 border-l border-[rgba(55,62,69,0.08)]">
        <button id="menu-close" class="absolute top-4 right-4 inline-flex h-10 w-10 items-center justify-center rounded-full border border-[rgba(55,62,69,0.12)] hover:bg-[#f7f8f9]" aria-label="Close menu">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
        <nav class="flex flex-col gap-2 pt-6" aria-label="Mobile">
          <a href="/services/" class="px-3 py-2 rounded-lg hover:bg-[#f7f8f9]">Services</a>
          <a href="/work/" class="px-3 py-2 rounded-lg hover:bg-[#f7f8f9]">Work</a>
          <a href="/about/" class="px-3 py-2 rounded-lg hover:bg-[#f7f8f9]">About</a>
          <a href="/insights/" class="px-3 py-2 rounded-lg hover:bg-[#f7f8f9]">Insights</a>
          <a href="/contact/" class="mt-2 inline-flex items-center justify-center rounded-lg bg-saffron px-4 py-2 font-semibold text-ink">Contact</a>
        </nav>
      </div>
    </div>
    <main id="main">
      <slot />
    </main>
    <!-- Footer -->
    <footer class="bg-charcoal text-white/80 mt-16">
      <div class="max-w-[1120px] mx-auto px-4 py-16">
        <!-- 5-column grid -->
        <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_4fr_2fr_2fr_2fr]">
          <!-- Col 1: Brand -->
          <div class="flex flex-col gap-4">
            <a href="/" class="inline-flex items-center">
              <img
                src="/icons/icon-d-integrated.svg"
                alt="Salt & Scale"
                height="40"
                width="143"
                class="h-10 w-auto brightness-0 invert"
              />
            </a>
            <p class="text-sm text-white/60 leading-snug">Growth, grounded in Truth.</p>
            <p class="text-sm text-white/50 leading-snug">Built by Gabriel Rosales · Houston, TX</p>
            <div class="flex items-center gap-3 mt-1">
              <!-- LinkedIn -->
              <a
                href="https://www.linkedin.com/in/gabriel-rosales/"
                rel="noopener noreferrer"
                target="_blank"
                aria-label="Gabriel Rosales on LinkedIn"
                class="text-white/50 hover:text-white transition-colors"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
              <!-- GitHub -->
              <a
                href="https://github.com/notoriousgor"
                rel="noopener noreferrer"
                target="_blank"
                aria-label="Gabriel Rosales on GitHub"
                class="text-white/50 hover:text-white transition-colors"
              >
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Col 2: Services -->
          <div>
            <p class="text-eyebrow text-white/40 mb-3">Services</p>
            <ul class="flex flex-col gap-2">
              <li><a href="/services/business-websites/" class="text-sm text-white/70 hover:text-white transition-colors">Websites for Service Businesses</a></li>
              <li><a href="/services/shopify-development/" class="text-sm text-white/70 hover:text-white transition-colors">Shopify Development</a></li>
              <li><a href="/services/adobe-commerce/" class="text-sm text-white/70 hover:text-white transition-colors">Adobe Commerce</a></li>
              <li><a href="/services/headless-commerce/" class="text-sm text-white/70 hover:text-white transition-colors">Headless Commerce</a></li>
              <li><a href="/services/custom-app-development/" class="text-sm text-white/70 hover:text-white transition-colors">Custom App Development</a></li>
              <li><a href="/services/integrations-automation/" class="text-sm text-white/70 hover:text-white transition-colors">Integrations & Automation</a></li>
              <li><a href="/services/audits-strategy/" class="text-sm text-white/70 hover:text-white transition-colors">Audits & Strategy</a></li>
            </ul>
          </div>

          <!-- Col 3: Work -->
          <div>
            <p class="text-eyebrow text-white/40 mb-3">Work</p>
            <ul class="flex flex-col gap-2">
              <li><a href="/work/mahi-plumbing/" class="text-sm text-white/70 hover:text-white transition-colors">Mahi Plumbing</a></li>
              <li><a href="/work/aim-global-transport/" class="text-sm text-white/70 hover:text-white transition-colors">AIM Global Transport</a></li>
              <li><a href="/work/premier-door-innovations/" class="text-sm text-white/70 hover:text-white transition-colors">Premier Door Innovations</a></li>
              <li><a href="/work/elevated-water-solutions/" class="text-sm text-white/70 hover:text-white transition-colors">Elevated Water Solutions</a></li>
              <li><a href="/work/" class="text-sm text-white/70 hover:text-white transition-colors">View all work →</a></li>
            </ul>
          </div>

          <!-- Col 4: Company -->
          <div>
            <p class="text-eyebrow text-white/40 mb-3">Company</p>
            <ul class="flex flex-col gap-2">
              <li><a href="/about/" class="text-sm text-white/70 hover:text-white transition-colors">About</a></li>
              <li><a href="/insights/" class="text-sm text-white/70 hover:text-white transition-colors">Insights</a></li>
              <li><a href="/contact/" class="text-sm text-white/70 hover:text-white transition-colors">Contact</a></li>
            </ul>
          </div>

          <!-- Col 5: Legal -->
          <div>
            <p class="text-eyebrow text-white/40 mb-3">Legal</p>
            <ul class="flex flex-col gap-2">
              <li><a href="/legal/privacy/" class="text-sm text-white/70 hover:text-white transition-colors">Privacy Policy</a></li>
              <li><a href="/legal/terms/" class="text-sm text-white/70 hover:text-white transition-colors">Terms of Service</a></li>
              <li><a href="/legal/accessibility/" class="text-sm text-white/70 hover:text-white transition-colors">Accessibility Statement</a></li>
            </ul>
          </div>
        </div>

        <!-- Divider -->
        <div class="mt-12 h-px w-full bg-white/10"></div>

        <!-- Bottom strip -->
        <div class="mt-6 grid gap-3 sm:grid-cols-3 sm:items-center">
          <p class="m-0 text-sm text-white/50 text-center sm:text-left">© 2026 Salt & Scale. Houston, TX.</p>
          <p id="sotd-verse" class="m-0 text-[13px] leading-snug text-white/40 text-center px-2">Loading daily scripture…</p>
          <p class="m-0 text-sm text-sage-soft text-center sm:text-right">Growth, grounded in Truth.</p>
        </div>
      </div>
    </footer>
    <script>
      // @ts-nocheck

      // simple in-view animation
      const animateObserver = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('opacity-100','translate-y-0');
            animateObserver.unobserve(e.target);
          }
        })
      }, { threshold: 0.15 });

      document.querySelectorAll('[data-animate]').forEach(el => {
        el.classList.add('opacity-0','translate-y-4','transition','duration-700');
        animateObserver.observe(el);
      });

      // Mobile menu
      const menu = document.getElementById('mobile-menu');
      const openBtn = document.getElementById('menu-toggle');
      const closeBtn = document.getElementById('menu-close');
      const overlay = document.getElementById('mobile-overlay');

      const mainEl = document.getElementById('main');
      const headerEl = document.querySelector('header');

      const openMenu = () => {
        menu?.classList.remove('hidden');
        openBtn?.setAttribute('aria-expanded','true');
        closeBtn?.focus();
        document.body.style.overflow = 'hidden';
        // WCAG 2.2 §9.2 — inert siblings so screen readers can't escape the dialog
        if (mainEl) mainEl.inert = true;
        if (headerEl) headerEl.inert = true;
      };

      const closeMenu = () => {
        menu?.classList.add('hidden');
        openBtn?.setAttribute('aria-expanded','false');
        openBtn?.focus();
        document.body.style.overflow = '';
        if (mainEl) mainEl.inert = false;
        if (headerEl) headerEl.inert = false;
      };

      openBtn?.addEventListener('click', openMenu);
      closeBtn?.addEventListener('click', closeMenu);
      overlay?.addEventListener('click', closeMenu);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });

      // Scripture of the Day (idle to avoid impacting metrics)
      const sotdEl = document.getElementById('sotd-verse');
      const loadSotd = () => {
        if (!sotdEl) return;
        fetch('https://beta.ourmanna.com/api/v1/get/?format=json&order=daily', { cache: 'no-store' })
          .then(r => r.json())
          .then(d => {
            const details = d?.verse?.details || d?.verses?.[0] || d;
            const text = details?.text || details?.verse || '';
            const ref = details?.reference || details?.display_ref || '';
            if (text) {
              sotdEl.textContent = ref ? `"${text}" — ${ref}` : `"${text}"`;
            } else {
              sotdEl.remove();
            }
          })
          .catch(() => sotdEl.remove());
      };

      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadSotd, { timeout: 2000 });
      } else {
        setTimeout(loadSotd, 1200);
      }
    </script>
  </body>
</html>
