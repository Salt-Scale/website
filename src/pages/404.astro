---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="mx-auto max-w-[720px] px-4 py-24 text-center">
    <div class="inline-flex items-center justify-center gap-2.5 px-3.5 py-1.5 bg-[#5a7c65]/10 border border-[#5a7c65]/20 rounded-full mb-6">
      <span class="w-1.5 h-1.5 bg-[#5a7c65] rounded-full"></span>
      <span class="text-[12px] leading-[1] font-medium text-[#5a7c65]">Page not found</span>
    </div>
    <h1 class="text-5xl font-bold mb-4">We can't find that page</h1>
    <p class="text-lg text-[#373e45]/70 mb-8">The link may be broken or the page may have moved.</p>
    <a href="/" class="inline-flex items-center gap-3 px-6 py-3 bg-gradient-to-r from-[#5a7c65] to-[#8b7d6b] text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition">
      Go home
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
    </a>
  </section>
</Layout>



