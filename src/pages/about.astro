---
import Layout from '../layouts/Layout.astro';

const personSchema = {
  '@type': 'Person',
  '@id': 'https://saltandscale.consulting/#founder',
  'name': 'Gabriel Rosales',
  'jobTitle': 'Founder & Principal Engineer',
  'worksFor': {
    '@type': 'Organization',
    '@id': 'https://saltandscale.consulting/#org',
    'name': 'Salt & Scale',
    'url': 'https://saltandscale.consulting/',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://saltandscale.consulting/icons/icon-c-monogram.svg',
    },
    'founder': { '@id': 'https://saltandscale.consulting/#founder' },
    'areaServed': 'United States',
    'knowsAbout': [
      'Website design',
      'Web development',
      'Shopify development',
      'Adobe Commerce',
      'Headless commerce',
      'AI-accelerated development',
      'Web accessibility',
      'Core Web Vitals',
    ],
    'sameAs': ['https://github.com/Salt-Scale'],
  },
  'image': 'https://saltandscale.consulting/headshot-square.jpg',
  'sameAs': [
    'https://www.linkedin.com/in/gabriel-rosales/',
    'https://github.com/notoriousgor',
    'https://github.com/Salt-Scale',
    'https://gabriel-rosales.com',
  ],
};

const tenets = [
  {
    heading: 'One senior engineer, end-to-end.',
    body: 'No handoffs, no junior work shipped, no agency overhead. Every line under the Salt & Scale name is written and reviewed by Gabriel personally.',
  },
  {
    heading: 'AI as a force multiplier, never a deliverable.',
    body: 'Anthropic Claude Partner. Every line is reviewed and owned by a human with 10+ years of production experience. AI accelerates; it does not replace engineering judgment.',
  },
  {
    heading: 'Production-grade fundamentals.',
    body: 'Hydrogen contributor, Shopify + Vercel Partner. Built for Core Web Vitals, WCAG 2.2 AA, and real ROI — not Lighthouse vanity scores.',
  },
];

const priorWork = [
  {
    role: 'Senior Engineer',
    company: 'Corra',
    projects: [
      { name: 'Sanrio', note: 'Shopify Plus + Magento PWA, Laravel APIs, infra leadership' },
      { name: 'PAX Labs', note: 'Shopify Plus headless program with Remix, Hydrogen, Oxygen; custom OMS in PHP/MySQL' },
      { name: 'Hive Brands', note: 'Custom apps, microservices for promos/ops, Coupon Card app' },
      { name: 'Thursday Boots Co.', note: 'Shopify Liquid/JS audits and front-end features' },
    ],
  },
];

const credentials = [
  '10+ years in production web engineering',
  'Open-source contributor to Shopify/hydrogen',
  'Shopify Partner',
  'Anthropic Claude Partner',
  'Vercel Partner',
];

const partners = [
  { label: 'Shopify Partner' },
  { label: 'Anthropic Claude Partner' },
  { label: 'Vercel Partner' },
];
---

<Layout
  title="About — Salt & Scale"
  description="Gabriel Rosales is the founder of Salt & Scale, a solo consultancy building production-grade websites for service businesses."
  canonicalPath="/about/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about/' },
  ]}
  schema={personSchema}
>
  <div class="bg-paper">

    <!-- Breadcrumb -->
    <div class="max-w-[1120px] mx-auto px-4 md:px-6 pt-8">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-1 text-caption text-stone">
          <li class="flex items-center gap-1">
            <a href="/" class="hover:text-sage hover:underline transition-colors duration-150">Home</a>
          </li>
          <li class="flex items-center gap-1">
            <span aria-hidden="true" class="text-stone/40">/</span>
            <span aria-current="page" class="text-charcoal font-medium">About</span>
          </li>
        </ol>
      </nav>
    </div>

    <!-- Hero section -->
    <div class="max-w-[1120px] mx-auto px-4 md:px-6 py-20 md:py-28">
      <p class="text-eyebrow text-saffron mb-4">About</p>
      <h1 class="text-display-1 text-ink mb-12 max-w-[20ch]">One engineer, ten years, every line.</h1>

      <!-- Founder block -->
      <div class="flex flex-col md:flex-row gap-12 md:gap-16 items-start">

        <!-- Portrait -->
        <div class="shrink-0">
          <div class="w-48 h-60 md:w-56 md:h-72 rounded-xl bg-cream border border-charcoal/10 overflow-hidden flex items-center justify-center">
            <!-- Headshot placeholder until Phase 2 image processing -->
            <span class="text-caption text-stone text-center px-4">Portrait — Phase 2</span>
          </div>
        </div>

        <!-- Bio + badges -->
        <div class="flex-1">
          <div class="mb-2">
            <p class="text-h4 text-ink">Gabriel Rosales</p>
            <p class="text-caption text-stone mt-1">Founder &amp; Principal Engineer &mdash; Houston, TX</p>
          </div>

          <p class="text-body text-charcoal max-w-[72ch] mt-6 leading-relaxed">
            Gabriel Rosales is the founder of Salt &amp; Scale, a solo consultancy in Houston building production-grade websites for service businesses. Over the past ten years he has shipped commerce engineering work for brands including Sanrio (at Corra), PAX Labs, Hive Brands, and Thursday Boots Co., and contributed open-source code to Shopify&rsquo;s Hydrogen storefront framework. Salt &amp; Scale is a Shopify Partner, an Anthropic Claude Partner, and a Vercel Partner &mdash; three credentials that map directly to how the work gets done: ecommerce platform fluency, AI used as a force multiplier (never a deliverable), and modern deployment infrastructure. Every line shipped under the Salt &amp; Scale name is written and reviewed by Gabriel personally.
          </p>

          <!-- Partner badges -->
          <div class="flex flex-wrap gap-3 mt-8">
            {partners.map((p) => (
              <span class="text-eyebrow text-saffron-deep border border-saffron/40 rounded-full px-4 py-1.5 bg-cream/60">
                {p.label}
              </span>
            ))}
          </div>

          <!-- Social links -->
          <div class="flex flex-wrap gap-4 mt-6">
            <a
              href="https://www.linkedin.com/in/gabriel-rosales/"
              rel="noopener"
              target="_blank"
              class="text-body text-sage hover:underline font-medium transition-colors duration-150"
            >LinkedIn &rarr;</a>
            <a
              href="https://github.com/notoriousgor"
              rel="noopener"
              target="_blank"
              class="text-body text-sage hover:underline font-medium transition-colors duration-150"
            >GitHub &rarr;</a>
            <a
              href="https://gabriel-rosales.com"
              rel="noopener"
              target="_blank"
              class="text-body text-sage hover:underline font-medium transition-colors duration-150"
            >gabriel-rosales.com &rarr;</a>
          </div>
        </div>

      </div>
    </div>

    <!-- What I believe -->
    <div class="max-w-[1120px] mx-auto px-4 md:px-6 pb-20 md:pb-28">
      <p class="text-eyebrow text-saffron mb-4">What I believe</p>
      <h2 class="text-display-2 text-ink mb-10">Three tenets.</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {tenets.map((t) => (
          <div class="bg-white rounded-xl border border-charcoal/10 p-8">
            <h3 class="text-h4 text-ink mb-4">{t.heading}</h3>
            <p class="text-body text-charcoal">{t.body}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Prior work -->
    <div class="max-w-[1120px] mx-auto px-4 md:px-6 pb-20 md:pb-28">
      <p class="text-eyebrow text-saffron mb-4">Prior work</p>
      <h2 class="text-display-2 text-ink mb-4">Before Salt &amp; Scale.</h2>
      <p class="text-body text-stone mb-10 max-w-[65ch]">
        The following projects were delivered at Corra as a senior engineer &mdash; prior employment, not Salt &amp; Scale case studies.
      </p>

      {priorWork.map((role) => (
        <div class="mb-10">
          <div class="flex items-baseline gap-3 mb-6 pb-4 border-b border-charcoal/10">
            <span class="text-h4 text-ink">{role.role}</span>
            <span class="text-caption text-stone">&mdash; {role.company}</span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {role.projects.map((proj) => (
              <div class="bg-white rounded-xl border border-charcoal/10 p-6">
                <p class="text-h4 text-ink mb-2">{proj.name}</p>
                <p class="text-body text-stone">{proj.note}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Open source -->
    <div class="max-w-[1120px] mx-auto px-4 md:px-6 pb-20 md:pb-28">
      <p class="text-eyebrow text-saffron mb-4">Open source</p>
      <h2 class="text-display-2 text-ink mb-6">Giving back to the stack.</h2>
      <p class="text-body text-charcoal max-w-[65ch] mb-6">
        Gabriel has contributed code to Shopify&rsquo;s open-source Hydrogen storefront framework and maintains public repositories under both personal and Salt &amp; Scale GitHub organizations.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="https://github.com/Shopify/hydrogen"
          rel="noopener"
          target="_blank"
          class="inline-flex items-center gap-2 font-semibold rounded-lg transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 border border-charcoal/20 text-charcoal hover:border-sage/60 hover:text-sage px-5 py-2.5 text-body"
        >
          Shopify/hydrogen contributions &rarr;
        </a>
        <a
          href="https://github.com/notoriousgor"
          rel="noopener"
          target="_blank"
          class="inline-flex items-center gap-2 font-semibold rounded-lg transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 border border-charcoal/20 text-charcoal hover:border-sage/60 hover:text-sage px-5 py-2.5 text-body"
        >
          GitHub: @notoriousgor &rarr;
        </a>
        <a
          href="https://github.com/Salt-Scale"
          rel="noopener"
          target="_blank"
          class="inline-flex items-center gap-2 font-semibold rounded-lg transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 border border-charcoal/20 text-charcoal hover:border-sage/60 hover:text-sage px-5 py-2.5 text-body"
        >
          GitHub: Salt-Scale org &rarr;
        </a>
      </div>
    </div>

    <!-- Credentials -->
    <div class="max-w-[1120px] mx-auto px-4 md:px-6 pb-20 md:pb-28">
      <p class="text-eyebrow text-saffron mb-4">Credentials</p>
      <h2 class="text-display-2 text-ink mb-8">By the numbers.</h2>
      <ul class="space-y-4">
        {credentials.map((c) => (
          <li class="flex gap-3 text-body text-charcoal">
            <span aria-hidden="true" class="text-sage mt-1 shrink-0">&mdash;</span>
            {c === 'Open-source contributor to Shopify/hydrogen' ? (
              <>
                Open-source contributor to{' '}
                <a
                  href="https://github.com/Shopify/hydrogen"
                  rel="noopener"
                  target="_blank"
                  class="text-sage hover:underline transition-colors duration-150"
                >Shopify/hydrogen</a>
              </>
            ) : (
              c
            )}
          </li>
        ))}
      </ul>
    </div>

  </div>

  <!-- CTA Band -->
  <section class="bg-charcoal text-white py-20 px-4">
    <div class="mx-auto max-w-[1120px] text-center">
      <h2 class="text-display-2 text-white mb-4">Ready to build something?</h2>
      <p class="text-body-lg text-white/70 max-w-xl mx-auto mb-10">
        Let&rsquo;s talk about what you&rsquo;re building. One call, no sales deck, just a straight conversation about your project.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 font-semibold rounded-lg transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-saffron focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal bg-saffron text-ink hover:opacity-90 px-7 py-3.5 text-lg"
        >
          Start a project
        </a>
        <a
          href="https://www.linkedin.com/in/gabriel-rosales/"
          rel="noopener"
          target="_blank"
          class="inline-flex items-center gap-2 font-semibold rounded-lg transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal border border-white/20 text-white hover:border-white/50 px-7 py-3.5 text-lg"
        >
          Connect on LinkedIn
        </a>
      </div>
    </div>
  </section>
</Layout>
