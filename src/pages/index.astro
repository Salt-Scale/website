    <script>
      // @ts-nocheck
      const modal = document.getElementById('case-modal');
      const content = document.getElementById('case-content');
      const closeBtn = document.getElementById('case-close');
      const open = (id) => {
        const tpl = document.getElementById(`case-${id}`);
        if (!tpl) return;
        content.innerHTML = '';
        content.appendChild(tpl.content.cloneNode(true));
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        closeBtn.focus();
      };
      const close = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };
      document.addEventListener('click', (e) => {
        const opener = e.target.closest('[data-case-open]');
        if (opener) {
          e.preventDefault();
          open(opener.getAttribute('data-case-open'));
        }
        if (
          e.target === modal ||
          e.target.id === 'case-overlay' ||
          e.target.id === 'case-close' ||
          e.target.closest && e.target.closest('#case-close')
        ) {
          close();
        }
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    </script>

