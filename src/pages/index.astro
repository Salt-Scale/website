---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- Hero Section -->
  <section class="relative isolate w-full bg-white overflow-hidden">
    <img src="/hero-texture.svg" alt="" class="pointer-events-none absolute inset-0 -z-10 h-full w-full select-none object-cover opacity-90" />
    
    <!-- Decorative elements -->
    <div class="absolute -top-40 -right-40 h-80 w-80 rounded-full bg-[#5a7c65]/10 blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 h-80 w-80 rounded-full bg-[#8b7d6b]/10 blur-3xl"></div>
    
    <div class="mx-auto max-w-[1120px] px-4 pt-24 pb-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-8">
          <div class="inline-flex items-center justify-center gap-2.5 px-3.5 py-1.5 bg-[#5a7c65]/10 border border-[#5a7c65]/20 rounded-full align-middle">
            <span class="w-1.5 h-1.5 bg-[#5a7c65] rounded-full flex-shrink-0"></span>
            <span class="font-semibold tracking-wide text-[#5a7c65] uppercase text-[12px] leading-[1]">Shopify & Adobe Commerce Development</span>
          </div>
          
          <h1 class="m-0 text-[clamp(2.5rem,7vw,4rem)] leading-[1.05] font-bold">
            Salt &amp; Scale — <em class="text-[#8b7d6b] text-[.8em]">Growth, grounded in Truth.</em>
    </h1>
          
          <p class="text-xl leading-relaxed text-[#373e45]/80 max-w-[56ch]">
            We specialize in solving complex e-commerce challenges using Shopify and
      Adobe Commerce. Whether you're scaling or enterprise, we architect, build,
      and optimize with integrity and measurable outcomes.
    </p>
          
          <div class="flex flex-col sm:flex-row gap-4">
      <a
        href="#contact"
              class="inline-flex items-center justify-center rounded-xl bg-[#5a7c65] px-8 py-4 text-lg font-semibold text-white border border-[#4a6b5a] shadow-lg transition-all duration-300 hover:shadow-xl hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5a7c65] focus-visible:ring-offset-2 active:translate-y-px"
      >
              Start a project
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
              </svg>
            </a>
      <a
        href="#services"
              class="inline-flex items-center justify-center rounded-xl bg-white/80 backdrop-blur-sm px-8 py-4 text-lg font-semibold text-[#8b7d6b] border-2 border-[#8b7d6b]/30 shadow-lg transition-all duration-300 hover:bg-white hover:border-[#8b7d6b] hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#8b7d6b] focus-visible:ring-offset-2"
            >
              See services
            </a>
          </div>
        </div>
        
        <div class="relative">
          <!-- Interactive 3D-style card stack -->
          <div class="relative group">
            <!-- Background card -->
            <div class="absolute inset-0 bg-gradient-to-br from-[#5a7c65]/20 to-[#8b7d6b]/20 rounded-3xl blur-xl transform rotate-3 group-hover:rotate-6 transition-transform duration-700"></div>
            
            <!-- Middle card -->
            <div class="absolute inset-0 bg-gradient-to-br from-[#5a7c65]/10 to-[#8b7d6b]/10 rounded-3xl blur-lg transform -rotate-2 group-hover:-rotate-4 transition-transform duration-700"></div>
            
            <!-- Main interactive card -->
            <div class="relative z-10 bg-white/95 backdrop-blur-sm rounded-3xl p-6 shadow-2xl border border-white/40 transform transition-all duration-700 hover:scale-105 hover:shadow-3xl hover:-translate-y-2">
              
              <!-- Dynamic service showcase header -->
              <div class="text-center mb-6">
                <div class="relative inline-block group/icon">
                  <div class="w-16 h-16 bg-gradient-to-br from-[#5a7c65] to-[#8b7d6b] rounded-2xl flex items-center justify-center mx-auto mb-4 transform group-hover/icon:rotate-12 group-hover/icon:scale-110 transition-all duration-500 shadow-lg">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                    </svg>
                  </div>
                  <div class="absolute -inset-2 bg-gradient-to-br from-[#5a7c65]/20 to-[#8b7d6b]/20 rounded-2xl blur-lg -z-10 group-hover/icon:blur-xl transition-all duration-500"></div>
                </div>
                <h3 class="text-xl font-bold text-[#373e45] mb-2">What We Build</h3>
                <p class="text-sm text-[#373e45]/70">Explore our core capabilities</p>
              </div>
              
              <!-- Interactive service showcase -->
              <div class="space-y-3 mb-6">
                <div class="group/item flex items-center gap-3 p-3 rounded-xl hover:bg-gradient-to-r hover:from-[#5a7c65]/8 hover:to-[#8b7d6b]/8 transition-all duration-300 border border-transparent hover:border-[#5a7c65]/10 hover:shadow-lg">
                  <div class="w-10 h-10 bg-gradient-to-br from-[#5a7c65] to-[#5a7c65]/90 rounded-xl flex items-center justify-center group-hover/item:scale-110 group-hover/item:rotate-3 transition-all duration-300 shadow-md">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <h4 class="font-semibold text-[#373e45] text-sm mb-0.5">E-commerce Architecture</h4>
                    <p class="text-xs text-[#373e45]/60">Scalable solutions that grow with you</p>
                  </div>
                </div>
                
                <div class="group/item flex items-center gap-3 p-3 rounded-xl hover:bg-gradient-to-r hover:from-[#8b7d6b]/8 hover:to-[#5a7c65]/8 transition-all duration-300 border border-transparent hover:border-[#8b7d6b]/10 hover:shadow-lg">
                  <div class="w-10 h-10 bg-gradient-to-br from-[#8b7d6b] to-[#8b7d6b]/90 rounded-xl flex items-center justify-center group-hover/item:scale-110 group-hover/item:-rotate-3 transition-all duration-300 shadow-md">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <h4 class="font-semibold text-[#373e45] text-sm mb-0.5">Custom Development</h4>
                    <p class="text-xs text-[#373e45]/60">Tailored solutions for unique needs</p>
                  </div>
                </div>
                
                <div class="group/item flex items-center gap-3 p-3 rounded-xl hover:bg-gradient-to-r hover:from-[#5a7c65]/8 hover:to-[#8b7d6b]/8 transition-all duration-300 border border-transparent hover:border-[#5a7c65]/10 hover:shadow-lg">
                  <div class="w-10 h-10 bg-gradient-to-br from-[#5a7c65] to-[#8b7d6b] rounded-xl flex items-center justify-center group-hover/item:scale-110 group-hover/item:rotate-3 transition-all duration-300 shadow-md">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <h4 class="font-semibold text-[#373e45] text-sm mb-0.5">Performance Optimization</h4>
                    <p class="text-xs text-[#373e45]/60">Lightning fast user experiences</p>
                  </div>
                </div>
              </div>
              

            </div>
          </div>
        </div>
    </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services" class="relative mx-auto max-w-[1120px] px-4 py-20 scroll-mt-24">
    <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 h-full w-screen bg-[#f5f8f6] -z-10"></div>
    <div class="pointer-events-none select-none absolute inset-x-0 -top-6 mx-auto h-12 w-[88%] rounded-full bg-gradient-to-r from-transparent via-[#5a7c65]/10 to-transparent blur-xl"></div>
    <div class="text-center mb-16">
      <div class="inline-flex items-center justify-center gap-2.5 px-3.5 py-1.5 bg-[#5a7c65]/10 border border-[#5a7c65]/20 rounded-full mb-6 align-middle">
        <span class="w-1.5 h-1.5 bg-[#5a7c65] rounded-full flex-shrink-0"></span>
        <span class="font-semibold tracking-wide text-[#5a7c65] uppercase text-[12px] leading-[1]">Core offerings</span>
      </div>
      <h2 class="text-4xl font-bold mb-6">Services</h2>
      <p class="text-xl text-[#373e45]/70 max-w-[70ch] mx-auto">
      We bring tailored technical solutions that drive performance and
      efficiency.
    </p>
    </div>
    
    <div class="grid lg:grid-cols-2 xl:grid-cols-3 gap-8">
      <article class="group relative bg-white rounded-2xl border border-[rgba(55,62,69,0.08)] p-8 shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#8b7d6b] to-[#5a7c65] rounded-t-2xl"></div>
        <div class="mb-6">
          <div class="w-12 h-12 bg-[#5a7c65]/10 rounded-xl flex items-center justify-center mb-4">
            <span class="text-2xl text-[#5a7c65]">1</span>
          </div>
          <h3 class="text-xl font-bold mb-4">E‑Commerce Solution Architecture</h3>
        </div>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Technical leadership on new or migrating builds</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Scalable architecture for Shopify or Adobe Commerce</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Headless strategy and architecture planning</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Tech stack evaluation and recommendations</span>
          </li>
        </ul>
      </article>

      <article class="group relative bg-white rounded-2xl border border-[rgba(55,62,69,0.08)] p-8 shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#8b7d6b] to-[#5a7c65] rounded-t-2xl"></div>
        <div class="mb-6">
          <div class="w-12 h-12 bg-[#8b7d6b]/10 rounded-xl flex items-center justify-center mb-4">
            <span class="text-2xl text-[#8b7d6b]">2</span>
          </div>
          <h3 class="text-xl font-bold mb-4">Custom App Development</h3>
        </div>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Private and public Shopify apps</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Admin tools for operational automation</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Integration‑focused apps (CRM, ERP, WMS)</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Custom APIs and secure backend services</span>
          </li>
        </ul>
      </article>

      <article class="group relative bg-white rounded-2xl border border-[rgba(55,62,69,0.08)] p-8 shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#8b7d6b] to-[#5a7c65] rounded-t-2xl"></div>
        <div class="mb-6">
          <div class="w-12 h-12 bg-[#5a7c65]/10 rounded-xl flex items-center justify-center mb-4">
            <span class="text-2xl text-[#5a7c65]">3</span>
          </div>
          <h3 class="text-xl font-bold mb-4">Headless Commerce Builds</h3>
        </div>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Headless Shopify with Next.js, Remix, Hydrogen</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">CMS integrations (Sanity, Contentful, and more)</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Performance for Lighthouse & Core Web Vitals</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Full deployment and CI/CD strategy</span>
          </li>
        </ul>
      </article>

      <article class="group relative bg-white rounded-2xl border border-[rgba(55,62,69,0.08)] p-8 shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#8b7d6b] to-[#5a7c65] rounded-t-2xl"></div>
        <div class="mb-6">
          <div class="w-12 h-12 bg-[#8b7d6b]/10 rounded-xl flex items-center justify-center mb-4">
            <span class="text-2xl text-[#8b7d6b]">4</span>
          </div>
          <h3 class="text-xl font-bold mb-4">Custom Feature Development</h3>
        </div>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Checkout customization and upsell features</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Bundling, subscriptions, loyalty integrations</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">UI/UX enhancements across desktop and mobile</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Theme development or headless frontend work</span>
          </li>
        </ul>
      </article>

      <article class="group relative bg-white rounded-2xl border border-[rgba(55,62,69,0.08)] p-8 shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#8b7d6b] to-[#5a7c65] rounded-t-2xl"></div>
        <div class="mb-6">
          <div class="w-12 h-12 bg-[#5a7c65]/10 rounded-xl flex items-center justify-center mb-4">
            <span class="text-2xl text-[#5a7c65]">5</span>
          </div>
          <h3 class="text-xl font-bold mb-4">Systems Integration & Automation</h3>
        </div>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">ERP, CRM, and 3PL integrations (real-time & batch)</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Sync inventory, orders, and customer data</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Workflow automation for marketing/fulfillment</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Webhooks, middleware, and third-party connectors</span>
          </li>
        </ul>
      </article>

      <article class="group relative bg-white rounded-2xl border border-[rgba(55,62,69,0.08)] p-8 shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-1">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#8b7d6b] to-[#5a7c65] rounded-t-2xl"></div>
        <div class="mb-6">
          <div class="w-12 h-12 bg-[#8b7d6b]/10 rounded-xl flex items-center justify-center mb-4">
            <span class="text-2xl text-[#8b7d6b]">6</span>
          </div>
          <h3 class="text-xl font-bold mb-4">Technical Audits & Strategy Consulting</h3>
        </div>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Code reviews and performance audits</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Security and scalability assessments</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Platform migration planning</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-[#5a7c65] mt-1">✓</span>
            <span class="text-[#373e45]/80">Executive reporting and documentation</span>
          </li>
        </ul>
      </article>


    </div>
  </section>

  <!-- Add-On Services Section -->
  <section class="mx-auto max-w-[1120px] px-4 py-14 scroll-mt-24">
    <div class="bg-white rounded-3xl p-10 border border-[rgba(55,62,69,0.08)]">
      <div class="text-center mb-12">
        <h3 class="text-3xl font-bold mb-4">Add‑On Services</h3>
        <p class="text-lg text-[#373e45]/70 max-w-[70ch] mx-auto">
          Additional expertise to complement your core project needs
        </p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-2 h-2 bg-[#5a7c65] rounded-full"></div>
            <span class="text-[#373e45]/80">API documentation and handoff packages</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-2 h-2 bg-[#5a7c65] rounded-full"></div>
            <span class="text-[#373e45]/80">DevOps and CI/CD setup for in‑house teams</span>
          </div>
        </div>
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-2 h-2 bg-[#8b7d6b] rounded-full"></div>
            <span class="text-[#373e45]/80">Shopify Plus and Adobe Commerce onboarding</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-2 h-2 bg-[#8b7d6b] rounded-full"></div>
            <span class="text-[#373e45]/80">Technical SEO reviews and schema integration</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Approach Section -->
  <section id="approach" class="relative mx-auto max-w-[1120px] px-4 py-20 bg-white rounded-3xl mx-4 border border-[rgba(55,62,69,0.08)] scroll-mt-24 mb-12 md:mb-16">
    <div class="pointer-events-none absolute inset-0 rounded-3xl bg-[linear-gradient(180deg,rgba(90,124,101,0.05)_0%,rgba(139,125,107,0.05)_100%)] -z-10"></div>
    <div class="pointer-events-none select-none -mt-8 mb-12 mx-auto h-px w-[92%] bg-gradient-to-r from-transparent via-[rgba(55,62,69,0.12)] to-transparent"></div>
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold mb-6">Approach</h2>
      <p class="text-xl text-[#373e45]/80 max-w-[70ch] mx-auto">
      Integrity first. We start with discovery and honest diagnostics,
      prioritize high-leverage improvements, and build in short, measurable
      cycles. Transparent comms, clear tradeoffs, and code built to last.
    </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      <div class="text-center group">
        <div class="w-16 h-16 bg-[#5a7c65]/20 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-300">
