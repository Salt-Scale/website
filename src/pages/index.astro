---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import headshot from "../assets/headshot-source.jpeg";

const pageTitle = "Salt & Scale – Websites that book the work.";
const pageDescription =
  "AI-accelerated website design and development for service businesses. Built by a senior engineer with 10+ years in production commerce.";

// Trade businesses first — those are the buyer profile we lead with.
const caseStudies = [
  {
    n: "01",
    slug: "mahi-plumbing",
    sector: "Residential plumbing",
    client: "Mahi Plumbing",
    location: "Houston, TX",
    description: "Owner-operated 24/7 plumber serving Houston and nine surrounding cities — built phone-first with a Trophy Catch personality and trust signals that convert at 2 AM.",
  },
  {
    n: "02",
    slug: "elevated-water-solutions",
    sector: "Multi-service plumbing",
    client: "Elevated Water Solutions",
    location: "Houston, TX",
    description: "Eleven-year master-plumber operation — eleven services across three categories, fifteen-area local SEO coverage, and photo proof of every install.",
  },
  {
    n: "03",
    slug: "premier-door-innovations",
    sector: "Aluminum doors",
    client: "Premier Door Innovations",
    location: "Houston, TX",
    description: "Houston aluminum door manufacturer — filterable gallery, four-category product architecture, and multi-form routing for contractor partners.",
  },
  {
    n: "04",
    slug: "aim-global-transport",
    sector: "B2B freight",
    client: "AIM Global Transport",
    location: "Houston, TX",
    description: "Nationwide freight carrier serving all 48 states — stat-led hero, six-service B2B catalog, and dual conversion paths for logistics buyers.",
  },
];

// "Who this is for" — explicit audience markers
const audienceMarkers = [
  "Solo tradespeople &amp; one-truck operators",
  "Two- to ten-person service crews",
  "Family-run plumbing, HVAC, electrical, roofing",
  "Independent contractors and remodelers",
  "Local landscaping, lawn &amp; pool operators",
  "Drain cleaning, pest control, locksmith shops",
];

// FTC-safe answers to small-business fears
const faqs = [
  {
    question: "Will this be too technical for me to manage day-to-day?",
    answer: "No. After launch you get a one-page written guide for the few things you'll actually touch — updating phone numbers, adding service areas, swapping photos. Most owners spend less than 10 minutes a month on the site. For anything bigger, send a Loom or a text and I handle it.",
  },
  {
    question: "How much does a site like this cost?",
    answer: "Fixed-price, written quote upfront. No hourly billing. Pricing depends on scope (number of services, service-area pages, custom features), but I'll give you a number in writing within three business days of the discovery call — and that's the number. No change-orders unless you change the scope.",
  },
  {
    question: "How long does it take to build?",
    answer: "Most builds ship in one to three weeks from kick-off. The fastest so far — Elevated Water Solutions — went from idea to production in seven days. Bigger scope (15+ pages, custom integrations, multiple stakeholders) can push toward four weeks. Every project has a written timeline before any code is written.",
  },
  {
    question: "Do I own the site or am I renting it from you?",
    answer: "You own everything. The code lives in a GitHub repo you own. The domain stays in your name. Hosting is on Vercel under your account. If we ever part ways, you walk away with the keys to the whole thing — no platform lock-in, no ransom.",
  },
  {
    question: "What if I want to change something after launch?",
    answer: "Built into the workflow. Small tweaks (copy, photos, new service area) are usually handled within a few business days. Bigger additions get a quick written estimate. Most clients keep me on retainer for an hour or two a month.",
  },
  {
    question: "What if I'm not happy with the design?",
    answer: "You see the first design within the first week, before most of the code is written. Two rounds of revisions are built into every fixed-price quote. We don't go to launch until you say it's right.",
  },
];

const approachSteps = [
  {
    n: "01",
    label: "Discovery",
    title: "Diagnose before prescribing.",
    body: "Goals, audience, constraints. Audit of current systems. You receive a written brief and a clear scope before any code gets written.",
  },
  {
    n: "02",
    label: "Build",
    title: "Short cycles, visible work.",
    body: "Design and development in week-long iterations with regular check-ins. AI accelerates scaffolding; every line is reviewed before it ships.",
  },
  {
    n: "03",
    label: "Launch",
    title: "Ship, then iterate.",
    body: "Deployed to Vercel with automated CI/CD. Post-launch performance monitoring and iterative improvements as the business grows.",
  },
];

const pillars = [
  {
    n: "01",
    title: "One senior engineer, end to end.",
    body: "No handoffs. No junior work shipped. No agency overhead. Every line of code is written and reviewed by Gabriel personally — the same engineer who scoped the work and who'll be there a year after launch.",
  },
  {
    n: "02",
    title: "AI as a force multiplier, never a deliverable.",
    body: "Anthropic Claude Partner. AI accelerates the build; ten years of production experience owns the quality. You get the velocity of AI development with the judgment of a senior engineer reviewing every output.",
  },
  {
    n: "03",
    title: "Production-grade fundamentals.",
    body: "Hydrogen contributor. Shopify Partner. Vercel Partner. Built for Core Web Vitals, WCAG 2.2 AA, and real ROI — not Lighthouse vanity scores. The same engineering standards used at brands like Sanrio and PAX Labs.",
  },
];

const insightStubs = [
  {
    title: "How to choose a website builder for a service business in 2026",
    tag: "Service businesses",
    meta: "Pillar · ~2,000 words",
  },
  {
    title: "The service-business website checklist",
    tag: "Service businesses",
    meta: "Pillar",
  },
  {
    title: "Why your site's INP score is a leading indicator of conversion",
    tag: "Performance",
    meta: "Engineering",
  },
];
---

<Layout title={pageTitle} description={pageDescription}>

  {/* ============================================================
       HERO — charcoal, dramatic, editorial
       ============================================================ */}
  <section class="bg-charcoal text-paper relative overflow-hidden grain grain-dark">
    <div class="relative mx-auto max-w-[1280px] px-6 md:px-10 pt-20 pb-24 md:pt-28 md:pb-32">

      {/* Eyebrow + saffron rule — audience-named */}
      <div class="flex items-center gap-4 mb-12 md:mb-16">
        <span class="block h-px w-12 bg-saffron" aria-hidden="true"></span>
        <p class="text-eyebrow text-saffron">For tradespeople &amp; service-business owners · Houston, TX</p>
      </div>

      {/* Massive headline — audience first, benefit second */}
      <h1 class="text-display-xl max-w-[18ch] mb-10">
        Websites for the trades <span class="italic font-normal text-saffron">that book the work.</span>
      </h1>

      {/* Subhead — direct, no-BS positioning for one-truck operators */}
      <p class="text-[clamp(1.125rem,1.5vw,1.5rem)] leading-[1.45] text-paper/75 max-w-[54ch] mb-12 md:mb-14 font-light">
        Fixed-price builds for solo operators and small crews.
        <span class="text-paper">Owner-to-owner. No agency overhead, no junior work, no hourly billing.</span>
      </p>

      {/* CTAs — "Schedule a call" leads (small-biz buyers want to talk) */}
      <div class="flex flex-wrap items-center gap-x-8 gap-y-5 mb-20 md:mb-28">
        <a
          href="/contact/"
          class="group inline-flex items-center gap-3 bg-saffron text-ink px-7 py-4 text-[0.95rem] font-medium tracking-wide hover:bg-cream transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-saffron focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal"
        >
          Schedule a call
          <span class="inline-block transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
        <a
          href="/work/"
          class="group inline-flex items-baseline gap-2 text-paper hover:text-saffron transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-saffron focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal text-[0.95rem] tracking-wide pb-1 border-b border-paper/30 hover:border-saffron"
        >
          See real builds
          <span class="inline-block transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>

      {/* Owner-friendly attributes (not engineer credentials) */}
      <div class="grid md:grid-cols-[1.4fr_1fr] gap-12 md:gap-20 pt-12 border-t border-paper/15">
        <div>
          <p class="text-eyebrow text-saffron mb-5">What we do</p>
          <p class="text-[1.0625rem] leading-[1.7] text-paper/75 max-w-[58ch]">
            Salt &amp; Scale builds the website your business actually needs — phone-first, mobile-first, fast, and easy to find on Google. Most builds ship in one to three weeks (Elevated Water Solutions: seven days, idea to production). One senior engineer, ten years in production web work. No agency middlemen, no junior hands on the code, no surprise fees.
          </p>
        </div>
        <div>
          <p class="text-eyebrow text-saffron mb-5">How we work</p>
          <ul class="space-y-3 text-[0.9375rem] text-paper/75">
            <li class="flex items-baseline gap-3">
              <span class="text-saffron/60 numeral text-sm" aria-hidden="true">+</span>
              Solo operator, owner-to-owner
            </li>
            <li class="flex items-baseline gap-3">
              <span class="text-saffron/60 numeral text-sm" aria-hidden="true">+</span>
              Fixed-price, written quote upfront
            </li>
            <li class="flex items-baseline gap-3">
              <span class="text-saffron/60 numeral text-sm" aria-hidden="true">+</span>
              One to three weeks, start to live
            </li>
            <li class="flex items-baseline gap-3">
              <span class="text-saffron/60 numeral text-sm" aria-hidden="true">+</span>
              You own everything — code, domain, host
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
       WHO THIS IS FOR — paper, audience self-recognition strip
       ============================================================ */}
  <section class="bg-paper border-b border-charcoal/8">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-16 md:py-20">
      <div class="grid md:grid-cols-[0.7fr_1.3fr] gap-8 md:gap-16 items-start">
        <div>
          <div class="flex items-center gap-4 mb-5">
            <span class="block h-px w-10 bg-saffron" aria-hidden="true"></span>
            <p class="text-eyebrow text-saffron-deep">Who this is for</p>
          </div>
          <h2 class="font-serif font-semibold text-[clamp(1.5rem,2.5vw,2rem)] leading-[1.15] tracking-[-0.015em] text-charcoal max-w-[18ch]">
            If you run the shop, <span class="italic font-normal text-saffron-deep">this is for you.</span>
          </h2>
        </div>
        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3 text-[1rem] leading-[1.55] text-charcoal/80">
          {audienceMarkers.map((marker) => (
            <li class="flex items-baseline gap-3">
              <span class="text-saffron-deep numeral text-sm shrink-0" aria-hidden="true">+</span>
              <span set:html={marker} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ============================================================
       TRUST STRIP — paper, tiny editorial detail
       ============================================================ */}
  <section class="bg-paper border-b border-charcoal/8" aria-label="Clients">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-8 md:py-10">
      <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
        <p class="text-eyebrow text-charcoal/40 shrink-0">Built for</p>
        <div class="flex flex-wrap items-center gap-x-6 md:gap-x-10 gap-y-2 font-serif italic text-charcoal/75 text-[1.0625rem]">
          <span>Mahi Plumbing</span>
          <span aria-hidden="true" class="text-saffron">·</span>
          <span>Elevated Water Solutions</span>
          <span aria-hidden="true" class="text-saffron">·</span>
          <span>Premier Door Innovations</span>
          <span aria-hidden="true" class="text-saffron">·</span>
          <span>AIM Global Transport</span>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
       MAHI PULL-QUOTE — cream, big editorial moment
       DRAFT: requires AJ's sign-off before publishing
       ============================================================ */}
  <section class="bg-cream relative">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 py-24 md:py-32">
      <figure class="text-center">
        <span class="block font-serif text-saffron text-[5rem] md:text-[7rem] leading-none mb-6 italic" aria-hidden="true">&ldquo;</span>
        <blockquote class="font-serif font-medium text-[clamp(1.5rem,3.2vw,2.5rem)] leading-[1.35] text-charcoal max-w-[28ch] mx-auto -mt-4">
          Gabriel took the &lsquo;Trophy Catch Plumber&rsquo; idea I had in my head and turned it into a site that actually feels like Mahi. <span class="text-saffron-deep italic">First time I saw it I couldn&rsquo;t talk for a minute.</span>
        </blockquote>
        <figcaption class="mt-10 md:mt-12 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 text-[0.875rem]">
          <span class="text-eyebrow text-charcoal/60">AJ</span>
          <span aria-hidden="true" class="h-px w-8 bg-charcoal/25 hidden sm:block"></span>
          <span class="text-charcoal/65">Owner, Mahi Plumbing · Houston, TX</span>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* ============================================================
       TWO SERVICE TRACKS — paper, asymmetric (primary > secondary)
       ============================================================ */}
  <section class="bg-paper relative">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-24 md:py-32">

      <div class="flex items-center gap-4 mb-14 md:mb-20">
        <span class="block h-px w-12 bg-saffron" aria-hidden="true"></span>
        <p class="text-eyebrow text-saffron-deep">Services</p>
      </div>

      <h2 class="text-display-1 text-charcoal max-w-[12ch] mb-16 md:mb-24">
        Two ways <span class="italic font-normal text-saffron-deep">we work</span>.
      </h2>

      <div class="grid md:grid-cols-[1.6fr_1fr] gap-12 md:gap-20">
        {/* Primary track */}
        <article class="border-t-2 border-saffron pt-8">
          <div class="flex items-baseline gap-5 mb-6">
            <span class="numeral text-saffron-deep text-[3.5rem] leading-none">01</span>
            <span class="text-eyebrow text-saffron-deep/80">Primary practice</span>
          </div>
          <h3 class="font-serif font-semibold text-[clamp(1.875rem,3.5vw,2.75rem)] leading-[1.1] tracking-[-0.018em] text-charcoal mb-6 max-w-[18ch]">
            Websites for service businesses.
          </h3>
          <p class="text-body-lg text-charcoal/75 max-w-[52ch] mb-10">
            Brand sites, lead-capture forms, local SEO foundation, and mobile-first builds for plumbers, truckers, manufacturers, and every service business in between.
          </p>
          <a
            href="/services/business-websites/"
            class="inline-flex items-baseline gap-2 text-charcoal hover:text-saffron-deep transition-colors duration-150 border-b border-saffron pb-1 text-[0.95rem] font-medium tracking-wide group"
          >
            Explore the practice
            <span class="inline-block transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </article>

        {/* Secondary track */}
        <article class="border-t border-charcoal/25 pt-8">
          <div class="flex items-baseline gap-5 mb-6">
            <span class="numeral text-charcoal/40 text-[3rem] leading-none">02</span>
            <span class="text-eyebrow text-charcoal/45">Ecommerce</span>
          </div>
          <h3 class="font-serif font-semibold text-[clamp(1.5rem,2.5vw,2rem)] leading-[1.15] tracking-[-0.015em] text-charcoal mb-6">
            Ecommerce engineering.
          </h3>
          <p class="text-body text-charcoal/70 mb-10">
            Shopify Plus, Adobe Commerce, headless builds, custom apps, and integrations for brands needing platform-depth expertise.
          </p>
          <a
            href="/services/"
            class="inline-flex items-baseline gap-2 text-charcoal hover:text-charcoal/80 transition-colors duration-150 border-b border-charcoal/40 hover:border-charcoal pb-1 text-[0.95rem] font-medium tracking-wide group"
          >
            See all services
            <span class="inline-block transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  {/* ============================================================
       SELECTED WORK — charcoal, editorial list
       ============================================================ */}
  <section class="bg-charcoal text-paper relative grain grain-dark">
    <div class="relative mx-auto max-w-[1280px] px-6 md:px-10 py-24 md:py-32">

      <div class="flex items-end justify-between mb-14 md:mb-20 flex-wrap gap-6">
        <div>
          <div class="flex items-center gap-4 mb-6">
            <span class="block h-px w-12 bg-saffron" aria-hidden="true"></span>
            <p class="text-eyebrow text-saffron">Selected work</p>
          </div>
          <h2 class="text-display-1 max-w-[14ch]">
            Built and <span class="italic font-normal text-saffron">shipped</span>.
          </h2>
        </div>
        <a
          href="/work/"
          class="group inline-flex items-baseline gap-2 text-paper/80 hover:text-saffron transition-colors duration-150 border-b border-paper/30 hover:border-saffron pb-1 text-[0.95rem] tracking-wide"
        >
          View all four
          <span class="inline-block transition-transform duration-150 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="divide-y divide-paper/15 border-t border-paper/15">
        {caseStudies.map((cs) => (
          <li>
            <a
              href={`/work/${cs.slug}/`}
              class="grid md:grid-cols-[64px_180px_1fr_auto] gap-x-6 md:gap-x-10 gap-y-3 items-baseline py-8 md:py-10 group hover:text-saffron transition-colors duration-150 -mx-6 md:-mx-10 px-6 md:px-10 hover:bg-paper/[0.03]"
            >
              <span class="numeral text-saffron text-[1.875rem] leading-none">{cs.n}</span>
              <span class="text-eyebrow text-paper/45 group-hover:text-saffron/80 transition-colors">{cs.sector}</span>
              <div>
                <h3 class="font-serif font-medium text-[clamp(1.5rem,2.5vw,2rem)] leading-[1.15] tracking-[-0.012em] text-paper group-hover:text-saffron transition-colors mb-2">
                  {cs.client}
                </h3>
                <p class="text-[0.9375rem] leading-[1.6] text-paper/65 max-w-[55ch]">{cs.description}</p>
              </div>
              <span class="hidden md:inline-block text-[0.9375rem] text-paper/50 group-hover:text-saffron group-hover:translate-x-1 transition-all duration-150 whitespace-nowrap" aria-hidden="true">View case →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ============================================================
       APPROACH — paper, numbered steps with editorial typography
       ============================================================ */}
  <section class="bg-paper">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-24 md:py-32">

      <div class="flex items-center gap-4 mb-14 md:mb-20">
        <span class="block h-px w-12 bg-saffron" aria-hidden="true"></span>
        <p class="text-eyebrow text-saffron-deep">How we work</p>
      </div>

      <h2 class="text-display-1 text-charcoal max-w-[14ch] mb-16 md:mb-24">
        Diagnose. Build. <span class="italic font-normal text-saffron-deep">Iterate.</span>
      </h2>

      <div class="grid md:grid-cols-3 gap-x-12 md:gap-x-16 gap-y-14">
        {approachSteps.map((s) => (
          <article>
            <div class="border-t border-charcoal/20 pt-6 flex items-baseline justify-between mb-8">
              <span class="numeral text-saffron-deep text-[3rem] leading-none">{s.n}</span>
              <span class="text-eyebrow text-charcoal/40">{s.label}</span>
            </div>
            <h3 class="font-serif font-semibold text-[1.625rem] leading-[1.2] tracking-[-0.012em] text-charcoal mb-4 max-w-[18ch]">
              {s.title}
            </h3>
            <p class="text-[1rem] leading-[1.65] text-charcoal/70 max-w-[40ch]">
              {s.body}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
       PILLARS — cream, each pillar gets its own moment
       ============================================================ */}
  <section class="bg-cream">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-24 md:py-32">

      <div class="flex items-center gap-4 mb-14 md:mb-20">
        <span class="block h-px w-12 bg-saffron" aria-hidden="true"></span>
        <p class="text-eyebrow text-saffron-deep">Why Salt &amp; Scale</p>
      </div>

      <h2 class="text-display-1 text-charcoal max-w-[20ch] mb-16 md:mb-24">
        Three things we do <span class="italic font-normal text-saffron-deep">differently</span>.
      </h2>

      <div class="space-y-16 md:space-y-24">
        {pillars.map((p) => (
          <article class="grid md:grid-cols-[180px_1fr] gap-6 md:gap-16">
            <div>
              <span class="numeral text-saffron-deep text-[3.5rem] leading-none">{p.n}</span>
              <p class="text-eyebrow text-charcoal/40 mt-4">Principle</p>
            </div>
            <div>
              <h3 class="font-serif font-semibold text-[clamp(1.625rem,3vw,2.25rem)] leading-[1.15] tracking-[-0.015em] text-charcoal mb-5 max-w-[22ch]">
                {p.title}
              </h3>
              <p class="text-body-lg text-charcoal/70 max-w-[58ch]">
                {p.body}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ============================================================
       FOUNDER — paper, portrait + bio editorial layout
       ============================================================ */}
  <section class="bg-paper">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-24 md:py-32">

      <div class="grid md:grid-cols-[0.85fr_1.15fr] gap-10 md:gap-20 items-start">

        {/* Portrait — wrapper isolates the face-focus zoom from object-cover */}
        <div class="relative">
          <div class="aspect-[4/5] bg-cream overflow-hidden">
            <div class="w-full h-full scale-[1.85] origin-[50%_22%]">
              <Image
                src={headshot}
                alt="Gabriel Rosales — Founder and Principal Engineer at Salt & Scale"
                widths={[320, 480, 720]}
                sizes="(min-width: 768px) 40vw, 100vw"
                format="avif"
                quality={62}
                loading="lazy"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
          <p class="text-eyebrow text-charcoal/45 mt-4">Gabriel Rosales · Houston, TX</p>
        </div>

        {/* Bio */}
        <div>
          <div class="flex items-center gap-4 mb-8">
            <span class="block h-px w-12 bg-saffron" aria-hidden="true"></span>
            <p class="text-eyebrow text-saffron-deep">The engineer behind the work</p>
          </div>

          <h2 class="font-serif font-semibold text-[clamp(2.25rem,4.5vw,3.5rem)] leading-[1.05] tracking-[-0.02em] text-charcoal mb-10 max-w-[16ch]">
            One engineer, ten years, <span class="italic font-normal text-saffron-deep">every line.</span>
          </h2>

          <p class="text-body-lg text-charcoal/75 mb-8 max-w-[56ch]">
            Gabriel Rosales is the founder of Salt &amp; Scale, a solo consultancy in Houston building production-grade websites for service businesses. Ten years shipping commerce engineering for brands including Sanrio (at Corra), PAX Labs, Hive Brands, and Thursday Boots — and open-source contributor to Shopify&rsquo;s Hydrogen storefront framework.
          </p>

          {/* Partner badges — typographic, not pill-y */}
          <ul class="flex flex-wrap gap-x-8 gap-y-3 mb-10">
            <li class="flex items-baseline gap-2 text-[0.875rem] text-charcoal/70">
              <span class="text-saffron-deep numeral" aria-hidden="true">+</span>
              Shopify Partner
            </li>
