  <!-- Contact Section -->
  <section id="contact" class="mx-auto max-w-[1120px] px-4 pt-12 pb-24">
    <div class="bg-gradient-to-br from-[--color-supporting-green]/5 to-[--color-accent-brown]/5 rounded-3xl p-12 border border-[--color-supporting-green]/10">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-6">Start a project</h2>
        <p class="text-xl text-[--color-primary-navy]/70 max-w-[70ch] mx-auto">
          Tell us where you are, what you're building, and where you want to grow.
        </p>
      </div>
      
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        class="max-w-[800px] mx-auto space-y-6"
      >
        <input type="hidden" name="form-name" value="contact" />
        
        <!-- Personal Information -->
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-medium text-[--color-primary-navy] mb-2">Your name *</label>
            <input
              required
              id="name"
              name="name"
              placeholder="Enter your name"
              class="w-full rounded-xl border border-[rgba(55,62,69,0.2)] bg-white px-4 py-4 text-[--color-primary-navy] placeholder-[--color-primary-navy]/50 focus:outline-none focus:ring-2 focus:ring-[--color-supporting-green] focus:border-transparent transition-all duration-200"
            />
          </div>
          
          <div>
            <label for="email" class="block text-sm font-medium text-[--color-primary-navy] mb-2">Email *</label>
            <input
              required
              id="email"
              type="email"
              name="email"
              placeholder="Enter your email"
              class="w-full rounded-xl border border-[rgba(55,62,69,0.2)] bg-white px-4 py-4 text-[--color-primary-navy] placeholder-[--color-primary-navy]/50 focus:outline-none focus:ring-2 focus:ring-[--color-supporting-green] focus:border-transparent transition-all duration-200"
            />
          </div>
        </div>

        <!-- Company Information -->
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label for="company" class="block text-sm font-medium text-[--color-primary-navy] mb-2">Company name</label>
            <input
              id="company"
              name="company"
              placeholder="Your company or organization"
              class="w-full rounded-xl border border-[rgba(55,62,69,0.2)] bg-white px-4 py-4 text-[--color-primary-navy] placeholder-[--color-primary-navy]/50 focus:outline-none focus:ring-2 focus:ring-[--color-supporting-green] focus:border-transparent transition-all duration-200"
            />
          </div>
          
          <div>
            <label for="phone" class="block text-sm font-medium text-[--color-primary-navy] mb-2">Phone number</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              placeholder="Your phone number"
              class="w-full rounded-xl border border-[rgba(55,62,69,0.2)] bg-white px-4 py-4 text-[--color-primary-navy] placeholder-[--color-primary-navy]/50 focus:outline-none focus:ring-2 focus:ring-[--color-supporting-green] focus:border-transparent transition-all duration-200"
            />
          </div>
        </div>

        <!-- Project Details -->
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label for="platform" class="block text-sm font-medium text-[--color-primary-navy] mb-2">Current platform</label>
            <select
              id="platform"
              name="platform"
              class="w-full rounded-xl border border-[rgba(55,62,69,0.2)] bg-white px-4 py-4 text-[--color-primary-navy] focus:outline-none focus:ring-2 focus:ring-[--color-supporting-green] focus:border-transparent transition-all duration-200"
            >
              <option value="">Select platform</option>
              <option value="shopify">Shopify</option>
              <option value="adobe-commerce">Adobe Commerce (Magento)</option>
              <option value="woocommerce">WooCommerce</option>
              <option value="custom">Custom solution</option>
              <option value="none">No platform yet</option>
              <option value="other">Other</option>
            </select>
          </div>
          
          <div>
            <label for="project-type" class="block text-sm font-medium text-[--color-primary-navy] mb-2">Project type</label>
            <select
              id="project-type"
              name="project-type"
              class="w-full rounded-xl border border-[rgba(55,62,69,0.2)] bg-white px-4 py-4 text-[--color-primary-navy] focus:outline-none focus:ring-2 focus:ring-[--color-supporting-green] focus:border-transparent transition-all duration-200"
            >
              <option value="">Select project type</option>
              <option value="new-build">New e-commerce build</option>
              <option value="migration">Platform migration</option>
              <option value="custom-app">Custom app development</option>
              <option value="headless">Headless commerce</option>
              <option value="integration">Systems integration</option>
              <option value="audit">Technical audit</option>
              <option value="consulting">Strategy consulting</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>

        <!-- Timeline & Budget -->
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label for="timeline" class="block text-sm font-medium text-[--color-primary-navy] mb-2">Timeline</label>
            <select
              id="timeline"
              name="timeline"
              class="w-full rounded-xl border border-[rgba(55,62,69,0.2)] bg-white px-4 py-4 text-[--color-primary-navy] focus:outline-none focus:ring-2 focus:ring-[--color-supporting-green] focus:border-transparent transition-all duration-200"
            >
              <option value="">Select timeline</option>
              <option value="asap">ASAP</option>
              <option value="1-3-months">1-3 months</option>
              <option value="3-6-months">3-6 months</option>
              <option value="6-12-months">6-12 months</option>
              <option value="12-plus-months">12+ months</option>
              <option value="flexible">Flexible</option>
            </select>
          </div>
          
          <div>
            <label for="budget" class="block text-sm font-medium text-[--color-primary-navy] mb-2">Budget range</label>
            <select
              id="budget"
              name="budget"
              class="w-full rounded-xl border border-[rgba(55,62,69,0.2)] bg-white px-4 py-4 text-[--color-primary-navy] focus:outline-none focus:ring-2 focus:ring-[--color-supporting-green] focus:border-transparent transition-all duration-200"
            >
              <option value="">Select budget range</option>
              <option value="under-25k">Under $25K</option>
              <option value="25k-50k">$25K - $50K</option>
              <option value="50k-100k">$50K - $100K</option>
              <option value="100k-250k">$100K - $250K</option>
              <option value="250k-500k">$250K - $500K</option>
              <option value="500k-plus">$500K+</option>
              <option value="discuss">Let's discuss</option>
            </select>
          </div>
        </div>
        
        <!-- Project Description -->
        <div>
          <label for="message" class="block text-sm font-medium text-[--color-primary-navy] mb-2">Project details *</label>
          <textarea
            required
            id="message"
            name="message"
            placeholder="Tell us about your project goals, challenges, and what you're looking to achieve..."
            rows="6"
            class="w-full rounded-xl border border-[rgba(55,62,69,0.2)] bg-white px-4 py-4 text-[--color-primary-navy] placeholder-[--color-primary-navy]/50 focus:outline-none focus:ring-2 focus:ring-[--color-supporting-green] focus:border-transparent transition-all duration-200 resize-none"
          ></textarea>
        </div>

        <!-- Additional Information -->
        <div>
          <label for="additional" class="block text-sm font-medium text-[--color-primary-navy] mb-2">Additional information</label>
          <textarea
            id="additional"
            name="additional"
            placeholder="Any other details, questions, or specific requirements..."
            rows="3"
            class="w-full rounded-xl border border-[rgba(55,62,69,0.2)] bg-white px-4 py-4 text-[--color-primary-navy] placeholder-[--color-primary-navy]/50 focus:outline-none focus:ring-2 focus:ring-[--color-supporting-green] focus:border-transparent transition-all duration-200 resize-none"
          ></textarea>
        </div>
        
        <div class="text-center">
          <button
            class="inline-flex items-center justify-center rounded-xl bg-[#5a7c65] px-8 py-4 text-lg font-semibold text-white border border-[#4a6b5a] shadow-lg transition-all duration-300 hover:shadow-xl hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#5a7c65] focus-visible:ring-offset-2 active:translate-y-px"
            type="submit"
          >
            Send message
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </section>
</Layout>
