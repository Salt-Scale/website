---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import Quote from "../components/Quote.astro";
import CTABand from "../components/CTABand.astro";
import Founder from "../components/Founder.astro";
import LogoStrip from "../components/LogoStrip.astro";

const pageTitle = "Salt & Scale – Websites that book the work.";
const pageDescription =
  "AI-accelerated website design and development for service businesses. Built by a senior engineer with 10+ years in production commerce.";

const clientLogos = [
  { name: "Mahi Plumbing", src: "/placeholder-logo.svg", href: "https://www.mahiplumbing.com/" },
  { name: "AIM Global Transport", src: "/placeholder-logo.svg", href: "https://www.aimtransports.com/" },
  { name: "Premier Door Innovations", src: "/placeholder-logo.svg", href: "https://www.premierdoor.org/" },
  { name: "Elevated Water Solutions", src: "/placeholder-logo.svg", href: "https://www.elevatedwatersolution.com/" },
];

const caseStudies = [
  {
    slug: "mahi-plumbing",
    sector: "Residential Plumbing",
    client: "Mahi Plumbing",
    description: "A 24/7 emergency plumber serving Houston and 9 surrounding cities — built phone-first with a Trophy Catch personality and trust signals that convert at 2 AM.",
    heroFact: "9-city service-area architecture with 24/7 phone-first UX",
  },
  {
    slug: "aim-global-transport",
    sector: "B2B Freight",
    client: "AIM Global Transport",
    description: "A nationwide freight carrier serving all 48 states — stat-led hero, 6-service B2B catalog, and dual conversion paths for logistics buyers.",
    heroFact: "Stat-led hero: 15+ years, 20+ fleet vehicles, 99.9% on-time delivery",
  },
  {
    slug: "premier-door-innovations",
    sector: "Manufacturing",
    client: "Premier Door Innovations",
    description: "A Houston aluminum door manufacturer — filterable gallery, 4-category product architecture, and multi-form routing for contractor partners.",
    heroFact: "Filterable gallery across 5 categories; FAQ with structured data",
  },
  {
    slug: "elevated-water-solutions",
    sector: "Multi-Service Plumbing",
    client: "Elevated Water Solutions",
    description: "An 11-year master-plumber operation — 11 services across 3 categories, 15-area local SEO coverage, and photo-proof of every install.",
    heroFact: "15 service areas with per-city local SEO; quote form on every page",
  },
];

const whyPillars = [
  {
    heading: "One senior engineer, end-to-end.",
    body: "No handoffs, no junior work shipped, no agency overhead. Every line of code is written and reviewed by Gabriel personally.",
  },
  {
    heading: "AI as a force multiplier, never a deliverable.",
    body: "Anthropic Claude Partner. AI accelerates the build — experience owns the quality. Every output is reviewed and owned by a human with 10+ years of production engineering.",
  },
  {
    heading: "Production-grade fundamentals.",
    body: "Hydrogen contributor, Shopify + Vercel Partner. Built for Core Web Vitals, WCAG 2.2 AA, and real ROI — not Lighthouse vanity scores.",
  },
];

const insightStubs = [
  {
    title: "How to choose a website builder for a service business in 2026",
    tag: "Service Businesses",
  },
  {
    title: "The service-business website checklist",
    tag: "Service Businesses",
  },
  {
    title: "Why your site’s INP score is a leading indicator of conversion",
    tag: "Performance",
  },
];
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- 1. Hero -->
  <section class="bg-charcoal text-white py-24 md:py-32 px-4">
    <div class="mx-auto max-w-[1120px]">
      <div class="max-w-[72ch]">
        <h1 class="text-display-1 text-white mb-6">
          Websites that book the work.
        </h1>
        <p class="text-body-lg text-white/70 mb-10 max-w-[60ch]">
          Built fast with AI. Engineered with 10 years in production commerce. One senior engineer, end to end.
        </p>
        <div class="flex flex-wrap gap-4 mb-12">
          <a
            href="/contact/"
            class="inline-flex items-center gap-2 font-semibold rounded-lg transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-saffron focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal bg-saffron text-ink hover:opacity-90 px-7 py-3.5 text-lg"
          >
            Start a project
          </a>
          <a
            href="/work/"
            class="inline-flex items-center gap-2 font-semibold rounded-lg transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal border border-white/20 text-white hover:border-white/50 px-7 py-3.5 text-lg"
          >
            See work
          </a>
        </div>
        <p class="text-body text-white/60 max-w-[65ch]">
          Salt &amp; Scale builds production-grade websites for service businesses — the kind that loads in under a second, passes WCAG 2.2 AA, and has a contact form that actually routes leads. Every site is designed and engineered by one senior developer with 10+ years building commerce systems for Shopify, Adobe Commerce, and headless stacks. AI accelerates the build; experience owns the quality.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Trust strip -->
  <section class="bg-paper py-10 px-4">
    <div class="mx-auto max-w-[1120px]">
      <p class="text-eyebrow text-stone text-center mb-6">Clients we've built for</p>
      <!-- Text fallback until real logos arrive -->
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-12 text-stone/60 text-sm font-medium" aria-label="Client list">
        <span>Mahi Plumbing</span>
        <span aria-hidden="true" class="text-stone/30">&middot;</span>
        <span>AIM Global Transport</span>
        <span aria-hidden="true" class="text-stone/30">&middot;</span>
        <span>Premier Door Innovations</span>
        <span aria-hidden="true" class="text-stone/30">&middot;</span>
        <span>Elevated Water Solutions</span>
      </div>
      <!-- Logo image stubs — swap src when real SVGs arrive -->
      <div class="sr-only">
        <img src="" alt="Mahi Plumbing" width="120" height="40" />
        <img src="" alt="AIM Global Transport" width="120" height="40" />
        <img src="" alt="Premier Door Innovations" width="120" height="40" />
        <img src="" alt="Elevated Water Solutions" width="120" height="40" />
      </div>
    </div>
  </section>

  <!-- 3. The Mahi quote -->
  <!-- DRAFT — requires client sign-off before publishing under AJ's name -->
  <section class="bg-cream py-20 px-4">
    <div class="mx-auto max-w-[1120px] max-w-[800px]">
      <Quote
        quote="Gabriel took the ‘Trophy Catch Plumber’ idea I had in my head and turned it into a site that actually feels like Mahi. The phone is right where customers need it at 2 AM, the trust badges are in the right spots, and the form doesn’t get in the way when somebody’s water heater goes out. First time I saw it I couldn’t talk for a minute."
        name="AJ"
        role="Owner"
        company="Mahi Plumbing (Houston, TX)"
        companyUrl="https://www.mahiplumbing.com/"
      />
    </div>
  </section>

  <!-- 4. Two service tracks -->
  <Section
    bg="bg-white"
    eyebrow="Services"
    title="Two ways we work."
  >
    <div class="grid md:grid-cols-2 gap-6 mt-2">
      <article class="bg-white rounded-2xl shadow-[0_4px_24px_rgba(55,62,69,0.08)] border border-[rgba(55,62,69,0.08)] p-8 flex flex-col gap-4">
        <Eyebrow label="Primary track" variant="saffron" />
        <h3 class="text-display-3 text-charcoal">Websites for service businesses</h3>
        <p class="text-body text-charcoal/70 flex-1">
          Brand sites, lead-capture forms, local SEO foundation, and mobile-first builds for plumbers, truckers, manufacturers, and every service business in between.
        </p>
        <a
          href="/services/business-websites/"
          class="inline-flex items-center gap-1.5 font-semibold text-saffron-deep hover:underline text-body mt-2"
        >
          Learn more
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </article>

      <article class="bg-white rounded-2xl shadow-[0_4px_24px_rgba(55,62,69,0.08)] border border-[rgba(55,62,69,0.08)] p-8 flex flex-col gap-4">
        <Eyebrow label="Ecommerce track" variant="sage" />
        <h3 class="text-display-3 text-charcoal">Ecommerce engineering</h3>
        <p class="text-body text-charcoal/70 flex-1">
          Shopify Plus, Adobe Commerce, headless builds, custom apps, and integrations for brands that need platform-depth expertise.
        </p>
        <a
          href="/services/"
          class="inline-flex items-center gap-1.5 font-semibold text-sage hover:underline text-body mt-2"
        >
          Learn more
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </article>
    </div>
  </Section>

  <!-- 5. Selected work -->
  <Section
    bg="bg-paper"
    eyebrow="Selected work"
    title="Built and shipped."
    lede="Four service-business websites — from Houston plumbers to nationwide freight carriers."
  >
    <div class="grid sm:grid-cols-2 gap-6 mt-2">
      {caseStudies.map((cs) => (
        <article class="bg-white rounded-2xl shadow-[0_4px_24px_rgba(55,62,69,0.08)] border border-[rgba(55,62,69,0.08)] p-8 flex flex-col gap-3">
          <Eyebrow label={cs.sector} variant="cream" />
          <h3 class="text-h4 text-charcoal">{cs.client}</h3>
          <p class="text-body text-charcoal/70 flex-1">{cs.description}</p>
          <p class="text-caption text-stone italic">{cs.heroFact}</p>
          <a
            href={`/work/${cs.slug}/`}
            class="inline-flex items-center gap-1.5 font-semibold text-saffron-deep hover:underline text-caption mt-2"
          >
            View case
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </Section>

  <!-- 6. How we work -->
  <Section
    bg="bg-white"
    eyebrow="How we work"
    title="Discovery. Build. Launch &amp; iterate."
    lede="Integrity first. We start with discovery and clear diagnostics, prioritize high-leverage work, and build in short, measurable cycles. Transparent communication, clear tradeoffs, and code built to last."
  >
    <div class="grid md:grid-cols-3 gap-8 mt-2">
      <div class="flex flex-col gap-3">
        <div class="w-10 h-10 rounded-xl bg-saffron/10 flex items-center justify-center shrink-0">
          <span class="text-saffron-deep font-bold text-h4">1</span>
        </div>
        <h3 class="text-h4 text-charcoal">Discovery &amp; Technical Audit</h3>
        <p class="text-body text-charcoal/70">
          Comprehensive analysis of your goals, audience, and current systems. You get a written brief and a clear scope before any code is written.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <div class="w-10 h-10 rounded-xl bg-saffron/10 flex items-center justify-center shrink-0">
          <span class="text-saffron-deep font-bold text-h4">2</span>
        </div>
        <h3 class="text-h4 text-charcoal">Build</h3>
        <p class="text-body text-charcoal/70">
          Design and development in short cycles with regular check-ins. AI accelerates the scaffolding; every line is reviewed before it ships. No surprises.
        </p>
      </div>

      <div class="flex flex-col gap-3">
        <div class="w-10 h-10 rounded-xl bg-saffron/10 flex items-center justify-center shrink-0">
          <span class="text-saffron-deep font-bold text-h4">3</span>
        </div>
        <h3 class="text-h4 text-charcoal">Launch &amp; iterate</h3>
        <p class="text-body text-charcoal/70">
          Deployed to Vercel with automated CI/CD. Post-launch support, performance monitoring, and iterative improvements as your business grows.
        </p>
      </div>
    </div>
  </Section>

  <!-- 7. Why Salt & Scale -->
  <Section
    bg="bg-paper"
    eyebrow="Why Salt &amp; Scale"
    title="What sets us apart."
  >
    <div class="grid md:grid-cols-3 gap-6 mt-2">
      {whyPillars.map((p) => (
        <Card>
          <h3 class="text-h4 text-charcoal mb-3">{p.heading}</h3>
          <p class="text-body text-charcoal/70">{p.body}</p>
        </Card>
      ))}
    </div>
  </Section>

  <!-- 8. Founder block -->
  <Section
    bg="bg-white"
    eyebrow="The engineer behind the work"
    title="One senior engineer."
  >
    <div class="mt-4">
      <Founder />
    </div>
  </Section>

  <!-- 9. Insights teaser -->
  <Section
    bg="bg-paper"
    eyebrow="From the blog"
    title="Insights."
    lede="Practical writing on websites, performance, and what actually moves the needle for service businesses."
  >
    <div class="grid md:grid-cols-3 gap-6 mt-2">
      {insightStubs.map((article) => (
        <article class="bg-white rounded-2xl shadow-[0_4px_24px_rgba(55,62,69,0.08)] border border-[rgba(55,62,69,0.08)] p-6 flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <Eyebrow label={article.tag} variant="cream" />
            <span class="text-caption text-stone border border-stone/20 rounded-full px-2.5 py-0.5">Coming soon</span>
          </div>
          <h3 class="text-h4 text-charcoal flex-1">{article.title}</h3>
          <a
            href="/insights/"
            class="inline-flex items-center gap-1.5 font-semibold text-saffron-deep hover:underline text-caption mt-2"
          >
            Read on launch
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </Section>

  <!-- 10. CTA band -->
  <CTABand
    title="Ready to build something that books work?"
    primaryLabel="Start a project"
    primaryHref="/contact/"
    secondaryLabel="See our work"
    secondaryHref="/work/"
  />

</Layout>
