      <div class="relative mx-4 w-full max-w-2xl bg-white rounded-2xl p-6 shadow-2xl border border-[rgba(55,62,69,0.08)]">
        <button id="case-close" class="absolute top-3 right-3 inline-flex h-8 w-8 items-center justify-center rounded-full border border-[rgba(55,62,69,0.12)] hover:bg-[#f7f8f9] cursor-pointer" aria-label="Close">
