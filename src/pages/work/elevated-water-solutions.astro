---
import Layout from '../../layouts/Layout.astro';

const schema = {
  '@type': 'CreativeWork',
  '@id': 'https://saltandscale.consulting/work/elevated-water-solutions/#case-study',
  name: 'Elevated Water Solutions: multi-service licensed plumbing website',
  creator: { '@id': 'https://saltandscale.consulting/#org' },
  about: {
    '@type': 'Organization',
    name: 'Elevated Water Solutions',
    url: 'https://www.elevatedwatersolution.com/',
  },
  abstract:
    'An 11+ year master-plumber operation expanding from water-heater specialty into water treatment, reverse osmosis, gas line work, and plumbing remodels across the Houston metro.',
};

const shipped = [
  'Eleven services across three categories (Water Heater work, Water Treatment, Gas Lines and Remodels), with deep navigation that respects the customer&rsquo;s mental model.',
  'Fifteen-area service-area map for local SEO: Houston, Katy, Cypress, Spring, The Woodlands, Conroe, Magnolia, Sugar Land, Channelview, Pasadena, Deer Park, Baytown, La Porte, Galena Park, and Jacinto City.',
  'Recent-installations photo gallery with location attribution. Each install captioned with its city for trust and local proof.',
  'Five-star review block with named-customer attribution (Alexis A., Daniel R., James T.). Real reviews retained from the existing site.',
  'Trusted-brand row featuring Rheem, Bradford White, Navien, Rinnai, and A.O. Smith as an installer-credibility signal.',
  'License and insurance display (RMPL #47030) paired with master-plumber positioning throughout the site.',
  'Dropdown service-needed contact form for free estimates, present on every service page so leads convert wherever they land.',
  'Per-service sub-pages with scoped FAQs and CTAs that match the searcher&rsquo;s exact intent.',
];

const meta = [
  { label: 'Year', value: '2024' },
  { label: 'Type', value: 'Full website build' },
  { label: 'Build time', value: '7 days, idea to production' },
  { label: 'Stack', value: 'Astro · Tailwind · Vercel' },
  { label: 'Live', value: 'elevatedwatersolution.com', href: 'https://www.elevatedwatersolution.com/' },
];
---

<Layout
  title="Elevated Water Solutions · Salt & Scale"
  description="An eleven-service, fifteen-area website for Elevated Water Solutions, with a quote form on every page and a recent-installations gallery for local proof."
  canonicalPath="/work/elevated-water-solutions/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Work', url: '/work/' },
    { name: 'Elevated Water Solutions', url: '/work/elevated-water-solutions/' },
  ]}
  schema={schema}
>

  {/* ============================================================
       BREADCRUMB
       ============================================================ */}
  <nav aria-label="Breadcrumb" class="bg-paper border-b border-charcoal/8">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-4">
      <ol class="flex items-center gap-2 text-[0.8125rem] tracking-wide">
        <li><a href="/" class="text-charcoal/70 hover:text-saffron-deep transition-colors">Home</a></li>
        <li aria-hidden="true" class="text-charcoal/30">/</li>
        <li><a href="/work/" class="text-charcoal/70 hover:text-saffron-deep transition-colors">Work</a></li>
        <li aria-hidden="true" class="text-charcoal/30">/</li>
        <li aria-current="page" class="text-charcoal/80">Elevated Water Solutions</li>
      </ol>
    </div>
  </nav>

  {/* ============================================================
       HERO — charcoal
       ============================================================ */}
  <section class="bg-charcoal text-paper relative overflow-hidden grain grain-dark">
    <div class="relative mx-auto max-w-[1280px] px-6 md:px-10 pt-20 pb-24 md:pt-28 md:pb-28">

      <div class="flex items-center gap-4 mb-10">
        <span class="block h-px w-12 bg-saffron" aria-hidden="true"></span>
        <p class="text-eyebrow text-saffron">Multi-service plumbing · Houston metro</p>
      </div>

      <h1 class="text-display-1 max-w-[16ch] mb-14 md:mb-20">Elevated Water Solutions</h1>

      <div class="grid md:grid-cols-[1.4fr_1fr] gap-12 md:gap-20 pt-12 border-t border-paper/15">
        <div>
          <p class="text-eyebrow text-saffron mb-5">The brief</p>
          <p class="text-[1.0625rem] leading-[1.7] text-paper/80 max-w-[58ch]">
            An eleven-year master-plumber operation expanding from water-heater specialty into water treatment, reverse osmosis, gas line work, and plumbing remodels across the Houston metro.
          </p>
        </div>

        <dl class="grid grid-cols-1">
          {meta.map((m) => (
            <div class="grid grid-cols-[6rem_1fr] gap-6 items-baseline py-3 border-b border-paper/15 last:border-b-0">
              <dt class="text-eyebrow text-saffron/80">{m.label}</dt>
              <dd class="text-[0.9375rem] text-paper/85">
                {m.href ? (
                  <a href={m.href} rel="noopener" target="_blank" class="hover:text-saffron transition-colors inline-flex items-baseline gap-2">
                    {m.value}
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                ) : (
                  m.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  {/* ============================================================
       WHAT WE SHIPPED — paper
       ============================================================ */}
  <section class="bg-paper">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-24 md:py-32">

      <div class="flex items-center gap-4 mb-14 md:mb-20">
        <span class="block h-px w-12 bg-saffron" aria-hidden="true"></span>
        <p class="text-eyebrow text-saffron-deep">What we shipped</p>
      </div>

      <h2 class="text-display-1 text-charcoal max-w-[20ch] mb-16 md:mb-24">
        Eleven services, <span class="italic font-normal text-saffron-deep">fifteen cities</span>.
      </h2>

      <ol class="grid md:grid-cols-2 gap-x-16 gap-y-10 md:gap-y-14 max-w-[1100px]">
        {shipped.map((item, i) => (
          <li class="grid grid-cols-[48px_1fr] gap-5 items-baseline border-t border-charcoal/15 pt-6">
            <span class="numeral text-saffron-deep text-[1.625rem] leading-none">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="text-[1.0625rem] leading-[1.6] text-charcoal/80 max-w-[46ch]" set:html={item}></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ============================================================
       STACK — paper
       ============================================================ */}
  <section class="bg-paper border-t border-charcoal/10">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-20 md:py-24">

      <div class="grid md:grid-cols-[200px_1fr] gap-8 md:gap-16 items-start">
        <div class="flex items-center gap-4">
          <span class="block h-px w-12 bg-saffron" aria-hidden="true"></span>
          <p class="text-eyebrow text-saffron-deep">Stack</p>
        </div>

        <ul class="font-serif text-[clamp(1.375rem,2.2vw,1.875rem)] leading-[1.5] text-charcoal/85 tracking-[-0.012em]">
          <li>Astro framework</li>
          <li><span class="text-charcoal/30 mr-2" aria-hidden="true">·</span>Tailwind v4 design system</li>
          <li><span class="text-charcoal/30 mr-2" aria-hidden="true">·</span>Vercel deployment</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ============================================================
       PULL-QUOTE — cream
       DRAFT — requires client sign-off before publishing
       ============================================================ */}
  <!-- DRAFT — requires client sign-off before publishing -->
  <section class="bg-cream">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10 py-24 md:py-32">
      <figure class="text-center">
        <span class="block font-serif text-saffron text-[5rem] md:text-[7rem] leading-none mb-6 italic" aria-hidden="true">&ldquo;</span>
        <blockquote class="font-serif font-medium text-[clamp(1.5rem,3.2vw,2.5rem)] leading-[1.35] text-charcoal max-w-[36ch] mx-auto -mt-4">
          Eleven years of work and I never had a site that represented it right. Gabriel built me one that looks as careful as the work itself. Eleven services laid out the way a customer thinks about them, fifteen service areas that actually rank locally, and a quote form on every page that gets me real leads. <span class="text-saffron-deep italic">I send people to it before they call.</span>
        </blockquote>
        <figcaption class="mt-10 md:mt-12 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 text-[0.875rem]">
          <span class="text-eyebrow text-charcoal/70">Emmanuel</span>
          <span aria-hidden="true" class="h-px w-8 bg-charcoal/25 hidden sm:block"></span>
          <span class="text-charcoal/65">Owner, Elevated Water Solutions · Houston, TX</span>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* ============================================================
       VISIT LIVE — paper
       ============================================================ */}
  <section class="bg-paper">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-20 md:py-28">
      <div class="grid md:grid-cols-[200px_1fr] gap-8 md:gap-16 items-baseline">
        <div class="flex items-center gap-4">
          <span class="block h-px w-12 bg-saffron" aria-hidden="true"></span>
          <p class="text-eyebrow text-saffron-deep">See it live</p>
        </div>

        <a
          href="https://www.elevatedwatersolution.com/"
          rel="noopener"
          target="_blank"
          class="group inline-flex items-baseline gap-4 font-serif italic text-[clamp(1.75rem,4vw,3rem)] leading-[1.05] tracking-[-0.018em] text-charcoal hover:text-saffron-deep transition-colors break-all"
        >
          elevatedwatersolution.com
          <span aria-hidden="true" class="not-italic font-sans text-[1.5rem] transition-transform duration-150 group-hover:translate-x-1 shrink-0">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  {/* ============================================================
       NEXT/PREV — paper
       ============================================================ */}
  <section class="bg-paper border-t border-charcoal/15">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-16 md:py-20">
      <div class="grid md:grid-cols-2 gap-10">

        <a href="/work/premier-door-innovations/" class="group block">
          <span class="text-eyebrow text-charcoal/65 inline-flex items-center gap-2 mb-4">
            <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:-translate-x-1">&larr;</span>
            Previous
          </span>
          <div class="flex items-baseline gap-4">
            <span class="numeral text-saffron-deep/70 text-[1.5rem] leading-none">03</span>
            <div>
              <p class="text-eyebrow text-charcoal/65 mb-2">Aluminum manufacturing</p>
              <p class="font-serif font-medium text-[clamp(1.375rem,2.2vw,1.875rem)] leading-[1.15] tracking-[-0.012em] text-charcoal group-hover:text-saffron-deep transition-colors">
                Premier Door Innovations
              </p>
            </div>
          </div>
        </a>

        <a href="/work/mahi-plumbing/" class="group block md:text-right">
          <span class="text-eyebrow text-charcoal/65 inline-flex items-center gap-2 mb-4">
            First case
            <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-1">&rarr;</span>
          </span>
          <div class="flex items-baseline gap-4 md:justify-end">
            <div class="md:order-2">
              <p class="text-eyebrow text-charcoal/65 mb-2">Residential plumbing</p>
              <p class="font-serif font-medium text-[clamp(1.375rem,2.2vw,1.875rem)] leading-[1.15] tracking-[-0.012em] text-charcoal group-hover:text-saffron-deep transition-colors">
                Mahi Plumbing
              </p>
            </div>
            <span class="numeral text-saffron-deep/70 text-[1.5rem] leading-none md:order-1">01</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* ============================================================
       CTA BAND — charcoal finale
       ============================================================ */}
  <section class="bg-charcoal text-paper relative overflow-hidden grain grain-dark">
    <div class="relative mx-auto max-w-[1280px] px-6 md:px-10 py-28 md:py-40 text-center">

      <p aria-hidden="true" class="font-serif text-saffron text-[2.5rem] leading-none mb-10 italic">⁂</p>

      <h2 class="font-serif font-semibold text-[clamp(2.5rem,6vw,5rem)] leading-[1.02] tracking-[-0.025em] mb-10 max-w-[18ch] mx-auto">
        Want to be <span class="italic font-normal text-saffron">the fifth?</span>
      </h2>

      <p class="text-body-lg text-paper/70 max-w-[52ch] mx-auto mb-14">
        One discovery call. A clear scope. A written proposal within three business days.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-5">
        <a
          href="/contact/"
          class="group inline-flex items-center gap-3 bg-saffron text-ink px-8 py-4 text-[0.95rem] font-medium tracking-wide hover:bg-cream transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-saffron focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal"
        >
          Start a project
          <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-1">&rarr;</span>
        </a>
        <a
          href="/work/"
          class="group inline-flex items-baseline gap-2 text-paper hover:text-saffron transition-colors duration-150 border-b border-paper/30 hover:border-saffron pb-1 text-[0.95rem] tracking-wide"
        >
          View all work
          <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-1">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

</Layout>
