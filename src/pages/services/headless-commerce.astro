---
import Layout from "../../layouts/Layout.astro";

const title = "Headless Commerce Builds – Salt & Scale";
const description = "Headless commerce development for Shopify and Adobe Commerce. Hydrogen, Remix, Next.js, and custom React front-ends with Core Web Vitals as a hard requirement.";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Services", url: "/services/" },
  { name: "Headless commerce builds", url: "/services/headless-commerce/" },
];

const serviceDescription = "Headless commerce decouples the storefront presentation layer from the commerce backend, letting you ship a faster, more flexible front-end while Shopify or Adobe Commerce handles catalog, checkout, and order management. Salt & Scale builds headless storefronts on Hydrogen (Shopify's Remix-based framework) deployed to Oxygen, custom Remix or Next.js front-ends against the Shopify Storefront API, and React/GraphQL storefronts for Adobe Commerce. Core Web Vitals — LCP under 2.5s, INP under 200ms, CLS under 0.1 — are treated as hard requirements, not optional goals. CMS integrations (Sanity, Contentful, or others) and automated CI/CD pipelines are included. Prior headless work includes a full Shopify Plus headless program for PAX Labs built with Hydrogen, Remix, and Oxygen, including a custom OMS in PHP and MySQL.";

const faqItems = [
  {
    question: "Does my store actually need to go headless?",
    answer: "Honestly, most stores don't. Headless adds real complexity — longer initial build time, a more involved CI/CD pipeline, and more moving parts to maintain. The case for headless is strong when you need editorial flexibility a CMS provides, you're targeting sub-2s LCP at scale, you have a design team building components independently from commerce engineers, or you're integrating with a mobile app that needs the same data. If you're unsure, start with a discovery call and we'll give you a direct answer."
  },
  {
    question: "What's the difference between Hydrogen, Remix, and Oxygen?",
    answer: "Hydrogen is Shopify's official headless commerce framework, built on top of Remix (a full-stack React framework). Oxygen is Shopify's edge hosting platform, designed to run Hydrogen apps close to users globally. You can build with Hydrogen locally and deploy elsewhere (Vercel, Netlify, Cloudflare), but Oxygen is often the right call for Shopify-native apps because it's free on Shopify plans and has first-class Storefront API integration."
  },
  {
    question: "What CMS do you recommend for headless?",
    answer: "Sanity is our default recommendation for most projects — it has a flexible schema, a good developer experience, and a generous free tier. Contentful works well for teams that already use it. For very simple content needs (blog posts, landing pages), we sometimes skip a dedicated CMS and use Astro Content Collections or MDX instead. The right choice depends on how much content your team manages and how technical your editors are."
  },
  {
    question: "How do you handle performance on a headless storefront?",
    answer: "Performance is built into the architecture from day one, not bolted on at the end. That means streaming HTML from the server, deferred client-side hydration, image optimization via Astro Image or next/image, font subsetting, critical-CSS inlining, and aggressive edge caching. We run Lighthouse and Web Vitals checks at every milestone, not just at launch."
  },
];

const schema = [
  {
    "@type": "Service",
    "@id": "https://saltandscale.consulting/services/headless-commerce/#service",
    "name": "Headless commerce builds",
    "serviceType": "Headless ecommerce development",
    "provider": { "@id": "https://saltandscale.consulting/#org" },
    "areaServed": "United States",
    "description": serviceDescription,
    "offers": {
      "@type": "Offer",
      "priceSpecification": { "@type": "PriceSpecification", "priceCurrency": "USD" }
    }
  },
  {
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": { "@type": "Answer", "text": item.answer }
    }))
  }
];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/services/headless-commerce/"
  breadcrumbs={breadcrumbs}
  schema={schema}
>
  <!-- Breadcrumb -->
  <nav aria-label="Breadcrumb" class="max-w-[1120px] mx-auto px-4 pt-6">
    <ol class="flex flex-wrap items-center gap-2 text-caption text-stone">
      <li><a href="/" class="hover:text-ink transition-colors">Home</a></li>
      <li aria-hidden="true" class="text-stone/50">›</li>
      <li><a href="/services/" class="hover:text-ink transition-colors">Services</a></li>
      <li aria-hidden="true" class="text-stone/50">›</li>
      <li class="text-ink" aria-current="page">Headless commerce builds</li>
    </ol>
  </nav>

  <!-- Hero / Answer block -->
  <section class="py-20 md:py-28 px-4 bg-paper">
    <div class="max-w-[1120px] mx-auto">
      <p class="text-eyebrow text-saffron-deep mb-4">Ecommerce engineering</p>
      <h1 class="text-display-1 text-ink mb-8 max-w-[22ch]">Headless commerce builds.</h1>
      <div class="max-w-[72ch] bg-cream rounded-2xl border border-sage/20 px-8 py-7">
        <p class="text-body text-charcoal/90 m-0">{serviceDescription}</p>
      </div>
    </div>
  </section>

  <!-- What's included -->
  <section class="py-20 md:py-28 px-4">
    <div class="max-w-[1120px] mx-auto">
      <p class="text-eyebrow text-sage mb-4">Scope of work</p>
      <h2 class="text-display-2 text-ink mb-10">What's included.</h2>
      <ul class="grid md:grid-cols-2 gap-6">
        <li class="bg-paper rounded-xl border border-sage/15 p-6">
          <h3 class="text-h4 text-ink mb-2">Hydrogen and Remix storefronts</h3>
          <p class="text-body text-charcoal/70">Shopify's official headless framework on Oxygen — streaming SSR, progressive enhancement, first-class Storefront API integration, and edge deployment by default.</p>
        </li>
        <li class="bg-paper rounded-xl border border-sage/15 p-6">
          <h3 class="text-h4 text-ink mb-2">Custom React / Next.js front-ends</h3>
          <p class="text-body text-charcoal/70">For teams not on Oxygen or those needing framework flexibility — Next.js App Router or Pages Router builds against Shopify or Adobe Commerce GraphQL APIs.</p>
        </li>
        <li class="bg-paper rounded-xl border border-sage/15 p-6">
          <h3 class="text-h4 text-ink mb-2">CMS integrations</h3>
          <p class="text-body text-charcoal/70">Sanity, Contentful, and other headless CMS integrations for editorial pages, landing pages, blogs, and marketing content — keeping commerce and content independent.</p>
        </li>
        <li class="bg-paper rounded-xl border border-sage/15 p-6">
          <h3 class="text-h4 text-ink mb-2">Core Web Vitals as a requirement</h3>
          <p class="text-body text-charcoal/70">LCP, INP, and CLS targets set upfront and verified throughout the build — not checked once at launch. Architecture decisions made with performance in mind from day one.</p>
        </li>
        <li class="bg-paper rounded-xl border border-sage/15 p-6">
          <h3 class="text-h4 text-ink mb-2">Automated deploys and CI/CD</h3>
          <p class="text-body text-charcoal/70">GitHub Actions or Vercel CI pipelines — lint, type-check, build, and deploy on every merge. Preview deployments for every pull request.</p>
        </li>
        <li class="bg-paper rounded-xl border border-sage/15 p-6">
          <h3 class="text-h4 text-ink mb-2">Headless strategy and architecture</h3>
          <p class="text-body text-charcoal/70">If you're evaluating whether to go headless, we offer a scoped discovery engagement that produces a written architecture recommendation and migration roadmap before any code is written.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- How we work -->
  <section class="py-20 md:py-28 px-4 bg-paper">
    <div class="max-w-[1120px] mx-auto">
      <p class="text-eyebrow text-sage mb-4">The process</p>
      <h2 class="text-display-2 text-ink mb-12">How we work.</h2>
      <ol class="grid md:grid-cols-3 gap-8">
        <li class="flex flex-col gap-4">
          <div class="w-10 h-10 rounded-full bg-saffron flex items-center justify-center text-ink font-bold text-sm flex-shrink-0">1</div>
          <div>
            <h3 class="text-h4 text-ink mb-2">Architecture and stack decision</h3>
            <p class="text-body text-charcoal/70">We map your catalog, team, CMS needs, and performance targets to the right framework and deployment architecture. Written recommendation before build begins.</p>
          </div>
        </li>
        <li class="flex flex-col gap-4">
          <div class="w-10 h-10 rounded-full bg-saffron flex items-center justify-center text-ink font-bold text-sm flex-shrink-0">2</div>
          <div>
            <h3 class="text-h4 text-ink mb-2">Incremental build with perf checks</h3>
            <p class="text-body text-charcoal/70">Pages built incrementally against real Shopify or Adobe Commerce data. Core Web Vitals checked at every milestone — not just before launch.</p>
          </div>
        </li>
        <li class="flex flex-col gap-4">
          <div class="w-10 h-10 rounded-full bg-saffron flex items-center justify-center text-ink font-bold text-sm flex-shrink-0">3</div>
          <div>
            <h3 class="text-h4 text-ink mb-2">Launch and CI handoff</h3>
            <p class="text-body text-charcoal/70">Live deployment with monitoring, full CI/CD pipeline documentation, and a runbook for your team. Code in your own repositories from day one.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Outcomes -->
  <section class="py-20 md:py-28 px-4">
    <div class="max-w-[1120px] mx-auto">
      <p class="text-eyebrow text-sage mb-4">What we aim for</p>
      <h2 class="text-display-2 text-ink mb-8">Outcomes we target.</h2>
      <div class="grid md:grid-cols-3 gap-6 mb-8">
        <div class="bg-paper rounded-xl border border-sage/15 p-6">
          <h3 class="text-h4 text-ink mb-3">Core Web Vitals passing</h3>
          <p class="text-body text-charcoal/70">The performance ceiling for headless is higher than traditional storefronts. We build to reach it: streaming SSR, edge caching, and progressive hydration from the ground up.</p>
        </div>
        <div class="bg-paper rounded-xl border border-sage/15 p-6">
          <h3 class="text-h4 text-ink mb-3">Conversion rate on the commerce path</h3>
          <p class="text-body text-charcoal/70">Faster pages and optimized checkout flows translate directly to conversion. We track the full funnel — PDP to cart to checkout — not just page-speed scores.</p>
        </div>
        <div class="bg-paper rounded-xl border border-sage/15 p-6">
          <h3 class="text-h4 text-ink mb-3">Developer velocity post-launch</h3>
          <p class="text-body text-charcoal/70">A headless storefront should make your team faster, not slower. Clean component architecture, typed APIs, and documented conventions reduce the cost of every feature that comes after launch.</p>
        </div>
      </div>
      <p class="text-caption text-stone max-w-[72ch]">
        Outcomes vary by project scope, existing platform health, and traffic volume. Metrics referenced elsewhere on this site are from individual engagements and are not guarantees of future results.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 md:py-28 px-4 bg-paper">
    <div class="max-w-[1120px] mx-auto">
      <p class="text-eyebrow text-sage mb-4">Common questions</p>
      <h2 class="text-display-2 text-ink mb-10">Frequently asked questions.</h2>
      <div class="max-w-[800px] space-y-3">
        {faqItems.map(item => (
          <details class="group bg-white rounded-xl border border-[rgba(55,62,69,0.10)] overflow-hidden">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5 text-h4 text-ink hover:bg-sage/5 transition-colors">
              {item.question}
              <span class="flex-shrink-0 text-stone group-open:rotate-45 transition-transform duration-200" aria-hidden="true">+</span>
            </summary>
            <div class="px-6 pb-6 pt-1">
              <p class="text-body text-charcoal/80">{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28 px-4 bg-charcoal">
    <div class="max-w-[1120px] mx-auto text-center">
      <p class="text-eyebrow text-saffron mb-4">Start a project</p>
      <h2 class="text-display-2 text-paper mb-6">Let's talk headless.</h2>
      <p class="text-body-lg text-paper/70 max-w-[54ch] mx-auto mb-10">
        Tell us your platform, current stack, and what the headless move is meant to solve. We'll respond within one business day with a direct read.
      </p>
      <a
        href="/contact?service=headless-commerce"
        class="inline-flex items-center gap-2 rounded-xl bg-saffron px-8 py-4 text-lg font-semibold text-ink shadow-sm transition-colors hover:bg-saffron/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-saffron focus-visible:ring-offset-2"
      >
        Start a project
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
