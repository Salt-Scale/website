---
import Layout from "../../layouts/Layout.astro";

const title = "Services · Salt & Scale";
const description = "Two ways we work: websites for service businesses built fast with AI, and ecommerce engineering for Shopify, Adobe Commerce, and headless builds.";

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Services", url: "/services/" },
];

const schema = [
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://saltandscale.consulting/" },
      { "@type": "ListItem", position: 2, name: "Services", item: "https://saltandscale.consulting/services/" },
    ],
  },
];

const ecommerceLinks = [
  {
    href: "/services/shopify-development/",
    title: "Shopify development",
    desc: "Liquid themes, Hydrogen headless, checkout extensibility, and app development by a Shopify Partner.",
  },
  {
    href: "/services/adobe-commerce/",
    title: "Adobe Commerce",
    desc: "Module work, PWA Studio, performance engineering, and B2B configuration on Commerce and Magento Open Source.",
  },
  {
    href: "/services/headless-commerce/",
    title: "Headless commerce",
    desc: "Hydrogen, Remix, and Next.js storefronts where Core Web Vitals are a hard requirement, not a goal.",
  },
  {
    href: "/services/custom-app-development/",
    title: "Custom app development",
    desc: "Private apps, public apps, internal tooling, and the backend services that connect them.",
  },
  {
    href: "/services/integrations-automation/",
    title: "Integrations & automation",
    desc: "ERP, CRM, and 3PL pipelines with retry logic, dead-letter queues, and observable failure states.",
  },
  {
    href: "/services/audits-strategy/",
    title: "Audits & strategy",
    desc: "Fixed-scope code, performance, security, and accessibility audits with written deliverables. No slide decks.",
  },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/services/"
  breadcrumbs={breadcrumbs}
  schema={schema}
>

  {/* Breadcrumb */}
  <nav aria-label="Breadcrumb" class="bg-paper border-b border-charcoal/8">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-4">
      <ol class="flex items-center gap-2 text-[0.8125rem] tracking-wide">
        <li><a href="/" class="text-charcoal/70 hover:text-saffron-deep transition-colors">Home</a></li>
        <li aria-hidden="true" class="text-charcoal/30">/</li>
        <li aria-current="page" class="text-charcoal/80">Services</li>
      </ol>
    </div>
  </nav>

  {/* ============================================================
       HERO — charcoal, editorial
       ============================================================ */}
  <section class="bg-charcoal text-paper relative overflow-hidden grain grain-dark">
    <div class="relative mx-auto max-w-[1280px] px-6 md:px-10 pt-20 pb-24 md:pt-28 md:pb-32">

      <div class="flex items-center gap-4 mb-12 md:mb-16">
        <span class="block h-px w-12 bg-saffron" aria-hidden="true"></span>
        <p class="text-eyebrow text-saffron">Services</p>
      </div>

      <h1 class="text-display-1 max-w-[16ch] mb-10">
        Built for the trades. <span class="italic font-normal text-saffron">Backed by ten years.</span>
      </h1>

      <p class="text-body-lg text-paper/75 max-w-[58ch]">
        Fixed-price websites for service businesses: plumbers, contractors, electricians, freight, manufacturing. Backed by a decade of production commerce engineering, available when the project actually needs it.
      </p>
    </div>
  </section>

  {/* ============================================================
       PRIMARY TRACK — paper, asymmetric, big numeral
       ============================================================ */}
  <section class="bg-paper relative">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-24 md:py-32">

      <div class="grid md:grid-cols-[1.6fr_1fr] gap-12 md:gap-20 items-start">

        <div class="border-t-2 border-saffron pt-10">
          <div class="flex items-baseline gap-6 mb-8">
            <span class="numeral text-saffron-deep text-[clamp(4rem,8vw,6.5rem)] leading-none">01</span>
            <div class="flex items-center gap-3">
              <span class="block h-px w-8 bg-saffron-deep/60" aria-hidden="true"></span>
              <p class="text-eyebrow text-saffron-deep/80">Primary practice</p>
            </div>
          </div>

          <h2 class="font-serif font-semibold text-[clamp(2.25rem,5vw,4rem)] leading-[1.04] tracking-[-0.022em] text-charcoal mb-8 max-w-[16ch]">
            Websites for <span class="italic font-normal text-saffron-deep">service businesses.</span>
          </h2>

          <p class="text-body-lg text-charcoal/75 max-w-[54ch] mb-8">
            Brand sites, lead-capture forms, local SEO foundation, and mobile-first builds for plumbers, contractors, freight companies, and every service business in between. Production-grade sites built fast with AI, designed to get the phone ringing and the form filling.
          </p>

          <p class="text-[1.0625rem] leading-[1.65] text-charcoal/65 max-w-[54ch] mb-10">
            Brand integration, accessibility-conformant builds, and full deployment included. Shipped on Astro, Tailwind, and Vercel. A stack chosen for speed and near-zero maintenance cost.
          </p>

          <a
            href="/services/business-websites/"
            class="group inline-flex items-center gap-3 bg-charcoal text-paper px-7 py-4 text-[0.95rem] font-medium tracking-wide hover:bg-saffron hover:text-ink transition-colors duration-150"
          >
            Explore the practice
            <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-1">→</span>
          </a>
        </div>

        {/* Right column — supporting detail */}
        <aside class="md:pt-10 md:border-l md:border-charcoal/10 md:pl-12">
          <p class="text-eyebrow text-charcoal/65 mb-6">Who it's for</p>
          <ul class="space-y-4 text-[1.0625rem] leading-[1.55] text-charcoal/75">
            <li class="flex items-baseline gap-3">
              <span class="text-saffron-deep numeral" aria-hidden="true">+</span>
              Plumbers, electricians, and home-service contractors
            </li>
            <li class="flex items-baseline gap-3">
              <span class="text-saffron-deep numeral" aria-hidden="true">+</span>
              Freight, logistics, and B2B operators
            </li>
            <li class="flex items-baseline gap-3">
              <span class="text-saffron-deep numeral" aria-hidden="true">+</span>
              Manufacturers and trade-network distributors
            </li>
            <li class="flex items-baseline gap-3">
              <span class="text-saffron-deep numeral" aria-hidden="true">+</span>
              Any service business whose phone needs to ring
            </li>
          </ul>

          <p class="text-eyebrow text-charcoal/65 mt-10 mb-4">Typical timeline</p>
          <p class="font-serif text-[1.625rem] leading-[1.2] tracking-[-0.012em] text-charcoal">
            1 – 3 weeks
          </p>
          <p class="text-[0.9375rem] text-charcoal/70 mt-1">kickoff to live, indexed site<br/>(fastest: 7 days)</p>
        </aside>
      </div>
    </div>
  </section>

  {/* ============================================================
       SECONDARY TRACK — cream, editorial link list
       ============================================================ */}
  <section class="bg-cream relative">
    <div class="mx-auto max-w-[1280px] px-6 md:px-10 py-24 md:py-32">

      <div class="grid md:grid-cols-[0.85fr_1.15fr] gap-12 md:gap-20 items-start">

        <header>
          <div class="flex items-baseline gap-6 mb-8">
            <span class="numeral text-charcoal/65 text-[clamp(3rem,6vw,5rem)] leading-none">02</span>
            <div class="flex items-center gap-3">
              <span class="block h-px w-8 bg-charcoal/30" aria-hidden="true"></span>
              <p class="text-eyebrow text-charcoal/70">Also offered</p>
            </div>
          </div>

          <h2 class="font-serif font-semibold text-[clamp(1.625rem,3vw,2.25rem)] leading-[1.15] tracking-[-0.015em] text-charcoal mb-6 max-w-[20ch]">
            Ecommerce engineering, <span class="italic font-normal text-saffron-deep">when you need it.</span>
          </h2>

          <p class="text-[1.0625rem] leading-[1.65] text-charcoal/70 max-w-[42ch]">
            A decade of Shopify, Adobe Commerce, and headless work for Sanrio (via Corra), PAX Labs, and Hive Brands. Currently a Sr. Customer Success Engineer at Adobe Commerce. Available for brands that already run on these platforms and need a senior engineer who owns every line.
          </p>
        </header>

        {/* Editorial link list */}
        <nav aria-label="Ecommerce services" class="md:pt-2">
          <ul class="border-t border-charcoal/15">
            {ecommerceLinks.map((link) => (
              <li class="border-b border-charcoal/15">
                <a
                  href={link.href}
                  class="group grid md:grid-cols-[1fr_auto] gap-x-8 items-baseline py-5 md:py-6 hover:text-saffron-deep transition-colors duration-150"
                >
                  <div>
                    <h3 class="font-serif font-medium text-[1.375rem] md:text-[1.5rem] leading-[1.2] tracking-[-0.012em] text-charcoal group-hover:text-saffron-deep transition-colors mb-1">
                      {link.title}
                    </h3>
                    <p class="text-[0.9375rem] leading-[1.55] text-charcoal/65 max-w-[58ch]">
                      {link.desc}
                    </p>
                  </div>
                  <span
                    aria-hidden="true"
                    class="hidden md:inline-block text-charcoal/65 group-hover:text-saffron-deep group-hover:translate-x-1 transition-all duration-150 mt-1"
                  >→</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </section>

  {/* ============================================================
       PRE-FOOTER CTA — charcoal, asterisk ornament finale
       ============================================================ */}
  <section class="bg-charcoal text-paper relative overflow-hidden grain grain-dark">
    <div class="relative mx-auto max-w-[1280px] px-6 md:px-10 py-28 md:py-40 text-center">

      <p aria-hidden="true" class="font-serif text-saffron text-[2.5rem] leading-none mb-10 italic">⁂</p>

      <h2 class="font-serif font-semibold text-[clamp(2.25rem,5vw,4rem)] leading-[1.04] tracking-[-0.022em] mb-10 max-w-[22ch] mx-auto">
        Ready to talk it <span class="italic font-normal text-saffron">through?</span>
      </h2>

      <p class="text-body-lg text-paper/70 max-w-[54ch] mx-auto mb-14">
        A 30-minute discovery call. Owner-to-owner. We figure out what you actually need, whether it's a fixed-price service-business site or a deeper ecommerce engagement. Written proposal within three business days.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-5">
        <a
          href="/contact/"
          class="group inline-flex items-center gap-3 bg-saffron text-ink px-8 py-4 text-[0.95rem] font-medium tracking-wide hover:bg-cream transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-saffron focus-visible:ring-offset-2 focus-visible:ring-offset-charcoal"
        >
          Schedule a call
          <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-1">→</span>
        </a>
        <a
          href="/work/"
          class="group inline-flex items-baseline gap-2 text-paper hover:text-saffron transition-colors duration-150 border-b border-paper/30 hover:border-saffron pb-1 text-[0.95rem] tracking-wide"
        >
          See selected work
          <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </section>

</Layout>
