# Salt & Scale website — required env vars
# Copy to .env.local for local dev. In production, set these in Vercel project settings.

# Resend API key — get from https://resend.com/api-keys
# Required for /api/contact to send email.
RESEND_API_KEY=

# Where contact-form submissions get delivered.
# Comma-separated for multiple recipients (e.g. "gabe@saltandscale.consulting,alerts@…").
CONTACT_TO=gabe@saltandscale.consulting

# From-address shown in the email envelope.
#
# ⚠️  DOMAIN VERIFICATION REQUIRED before this value will deliver.
# Resend rejects sends from any domain not verified in your dashboard:
#   1. https://resend.com/domains → "Add Domain" → saltandscale.consulting
#   2. Add the SPF / DKIM / DMARC records Resend gives you to your DNS provider
#   3. Wait for verification status to go green (usually <10 min)
#
# Until then, use Resend's sandbox sender for testing:
#   CONTACT_FROM=Salt & Scale <onboarding@resend.dev>
# Sandbox sends only deliver to the same Resend account's verified email.
CONTACT_FROM=Salt & Scale Website <hello@saltandscale.consulting>

# Canonical site URL — used in canonical tags, sitemap, JSON-LD, OG tags.
# REQUIRED in Vercel production (astro.config.mjs throws if it's missing
# there). For local dev and Vercel preview deploys we fall back to the
# canonical apex so structured data always resolves to a real asset.
SITE_URL=https://saltandscale.consulting
